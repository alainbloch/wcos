# WCoS Application Configuration
# Copy to .env and customize

# Server
PORT=3000
NODE_ENV=development
HOST=0.0.0.0
# Optional: TRUST_PROXY=1 when behind one trusted HTTPS proxy (automatic on Railway).
# TRUST_PROXY=0 disables forwarded-protocol trust.

# Session
SESSION_SECRET=your-super-secret-session-key-change-in-production
SESSION_COOKIE_NAME=wcos_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax

# Database (Lowdb JSON file)
DB_PATH=./data/db.json

# Admin
ADMIN_EMAIL=admin@wcos.org
ADMIN_PASSWORD=  # Required only for first startup with an empty database; use a strong unique password

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d

# File Uploads
UPLOAD_DIR=./public/uploads
MAX_FILE_SIZE=10485760

# External
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# Contact form delivery (optional for browsing; required to actually send mail)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
CONTACT_FROM=
CONTACT_TO=westerncouncil@gmail.com
