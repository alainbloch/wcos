{
  "name": "wcos",
  "version": "1.0.0",
  "description": "Western Circle of Swordfighters - Node.js CMS Application",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/app.js",
    "start": "node src/app.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPatterns=tests/unit",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPatterns=tests/integration",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "db:seed": "node scripts/seed-database.js",
    "db:reset": "node scripts/reset-database.js",
    "migrate:site": "node scripts/migrate-site.js"
  },
  "keywords": [
    "wcos",
    "swordfighters",
    "cms",
    "nodejs"
  ],
  "author": "WCoS",
  "license": "MIT",
  "dependencies": {
    "@fastify/cookie": "^9.0.0",
    "@fastify/formbody": "^7.0.0",
    "@fastify/multipart": "^8.0.0",
    "@fastify/session": "^10.0.0",
    "@fastify/static": "^7.0.4",
    "bcryptjs": "^2.4.3",
    "chokidar": "^3.6.0",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.0",
    "jsonwebtoken": "^9.0.2",
    "lowdb": "^7.0.1",
    "markdown-it": "^14.1.0",
    "nodemailer": "^10.2.1",
    "nunjucks": "^3.2.4",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.33.0",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "cheerio": "^1.2.0",
    "eslint": "^8.57.0",
    "jest": "^30.5.2",
    "prettier": "^3.3.0",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
