<div class="news-grid">
{% for update in newsUpdates %}
<article class="news-card">
  {% if update.image %}
  <div class="news-card-image">
    {% if update.pageLink %}<a href="/{{ update.pageLink }}" aria-label="{{ update.title or 'Read news' }}">{% endif %}
    <img src="{{ update.image }}" alt="{{ update.title }}" loading="lazy" decoding="async">
    {% if update.pageLink %}</a>{% endif %}
  </div>
  {% endif %}
  {% if update.subcategory %}<div class="news-card-category">{{ update.subcategory }}</div>{% endif %}
  {% if update.title %}<h3 class="news-card-title">{% if update.pageLink %}<a href="/{{ update.pageLink }}">{% endif %}{{ update.title }}{% if update.pageLink %}</a>{% endif %}</h3>{% endif %}
  <div class="news-card-date"><svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16"><circle cx="12" cy="12" r="10" fill="currentColor"></circle><path d="M11 6h2v5.5l3.6 2.7-1.2 1.6L11 12.5z" fill="#01030b"></path></svg> {{ update.dateLabel }}</div>
  <div class="news-card-excerpt">{{ update.body | safe }}</div>
  {% if update.pageLink %}<a class="news-card-readmore" href="/{{ update.pageLink }}">Read More <span aria-hidden="true">→</span></a>{% endif %}
</article>
{% else %}
<p class="news-empty">No news updates yet.</p>
{% endfor %}
</div>
