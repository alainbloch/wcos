[
  {
    "name": "Jumping Tiger",
    "category": "",
    "description": "Starts in defensive stance (Right Stance). Swordsman shuffles forward with full circle angled neck cut over the swordsman’s right shoulder. When the opponent blocks, the swordsman cross-steps to their left (off-line) with a full circle over-head cut straight down on the opponent’s exposed arm. As the cut completes the final arc, the swordsman’s right foot should swing around behind them in a sliding motion, so that they end up in a proper left stance when the cut is finished. This move is only effective if done with full commitment on the initial cut, and it is most useful with a feint.",
    "details": "",
    "core": true,
    "creatorId": "",
    "media": [],
    "order": 0
