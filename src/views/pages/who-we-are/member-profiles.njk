{% extends 'layouts/base.njk' %}

{% block content %}
<div class="container">
  <header class="page-header">
    <h1 class="page-title">{{ pageTitle }}</h1>
  </header>

  {% if membersGrouped %}
  {% for level in membersGrouped %}
  <section class="section">
    <h2 class="section-title">{{ level }}</h2>
    <div class="table-container">
      <table class="table">
        <thead>
          <tr>
            <th>Level</th>
            <th>Circle Name</th>
            <th>Position & Merits</th>
            <th>Member Since</th>
            <th>Region</th>
          </tr>
        </thead>
        <tbody>
          {% for member in membersGrouped[level] %}
          <tr>
            <td><strong>{{ member.level }}</strong></td>
            <td>{{ member.circleName }}</td>
            <td>{{ member.position }}</td>
            <td>{{ member.memberSince }}</td>
            <td>{{ member.region }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
  {% endfor %}
  {% else %}
  <div class="text-center py-12">
    <p class="text-muted">No members found.</p>
    {% if user %}
    <a href="/admin/members" class="btn btn-primary mt-4">Add Members</a>
    {% endif %}
  </div>
  {% endif %}
</div>
{% endblock %}