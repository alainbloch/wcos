{% extends 'layouts/base.njk' %}

{% block content %}
<div class="container">
  <header class="page-header">
    <h1 class="page-title">{{ pageTitle }}</h1>
  </header>

  {% if membersGrouped %}
  {% for entry in membersGrouped | entries %}
  <section class="section">
    <h2 class="section-title">{{ entry.key }}</h2>
    <div class="member-grid">
      {% for member in entry.value %}
      {% if member.active %}
      <article class="member-card" data-member="{{ member.id }}">
        {% if member.image %}
        <div class="member-photo">
          <img src="{{ member.image }}" alt="{{ member.position }}" loading="lazy">
        </div>
        {% else %}
        <div class="member-photo placeholder">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </div>
        {% endif %}
        
        <div class="member-info">
          <header class="member-header">
            <h3 class="member-name">{{ member.position }}</h3>
            <div class="member-meta">
              <span class="member-level">{{ member.level }}{% if member.steelRank and member.steelRank != member.level %} ({{ member.steelRank }}){% endif %}</span>
              <span class="member-circle">{{ member.circleName }}</span>
            </div>
          </header>

          {% if member.merits and member.merits.length > 0 %}
          <div class="member-merits">
            {% for merit in member.merits %}
            <span class="merit-badge">{{ merit }}</span>
            {% endfor %}
          </div>
          {% endif %}

          {% if member.memberSince %}
          <div class="member-detail">
            <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <span>Member since: {{ member.memberSince }}</span>
          </div>
          {% endif %}

          {% if member.region %}
          <div class="member-detail">
            <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>{{ member.region }}</span>
          </div>
          {% endif %}

          {% if member.biography %}
          <details class="member-bio">
            <summary>Biography</summary>
            <div class="bio-content">{{ member.biography | safe }}</div>
          </details>
          {% endif %}
        </div>
      </article>
      {% endif %}
      {% endfor %}
    </div>
  </section>
  {% endfor %}
  {% else %}
  <div class="text-center py-12">
    <p class="text-muted">No members found.</p>
  </div>
  {% endif %}
</div>
{% endblock %}