{% extends 'layouts/base.njk' %}

{% block content %}
<div class="container">
  <header class="page-header">
    <h1 class="page-title">{{ pageTitle }}</h1>
  </header>

  <!-- Current Council -->
  <section class="section">
    <h2 class="section-title">The Current Council Members</h2>
    <p>The Council of the WCoS is made of three Kaidens. They are there to help guide and shape the circle.</p>

    {% if council and council.length > 0 %}
    <div class="grid grid-3">
      {% for member in council %}
      <article class="card council-card">
        <div class="card-body text-center">
          {% if member.image %}
          <img src="{{ member.image }}" alt="{{ member.name }}" class="council-image" style="width: 150px; height: 150px; border-radius: 50%; object-fit: cover; margin-bottom: var(--space-4); border: 3px solid var(--color-accent);">
          {% else %}
          <div class="council-placeholder" style="width: 150px; height: 150px; border-radius: 50%; background: var(--color-surface-alt); margin: 0 auto var(--space-4); display: flex; align-items: center; justify-content: center; font-size: 3rem;">⚔️</div>
          {% endif %}
          <h3 class="council-name">{{ member.name }}</h3>
          <p class="council-title">{{ member.title }}</p>
        </div>
      </article>
      {% endfor %}
    </div>
    {% endif %}
  </section>

  <!-- Historical Council Dates -->
  {% if historicalDates and historicalDates.length > 0 %}
  <section class="section">
    <h2 class="section-title">Historical Council Formations</h2>
    <div class="timeline">
      {% for entry in historicalDates %}
      <div class="timeline-item">
        <div class="timeline-date">{{ entry.historicalDate | date('MMMM d, yyyy') }}</div>
        <div class="timeline-content">
          <h4>{{ entry.title or 'Council Formation' }}</h4>
          {% if entry.description %}
          <p>{{ entry.description }}</p>
          {% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}
</div>
{% endblock %}