{% extends 'layouts/base.njk' %}

{% block content %}
<div class="container">
  <header class="page-header">
    <h1 class="page-title">{{ pageTitle }}</h1>
    {% if pageSubtitle %}
    <p class="page-subtitle">{{ pageSubtitle }}</p>
    {% endif %}
  </header>

  <div class="hero-description" style="max-width: 800px; margin: 0 auto var(--space-10); text-align: center; color: var(--color-text-muted);">
    Best of Best competition champions – This is a yearly competition run by the Head Kaiden to determine who is the best fighter in the Western Circle through a series of one on one duels. During these matches only the cleanest kills are accepted and each match is watched and judged by 3 Kaidens.
  </div>

  {% if championsByDecade %}
  {% for decade in championsByDecade %}
  <section class="section">
    <h2 class="section-title">{{ decade }} Champions</h2>
    <div class="grid grid-4">
      {% for champion in championsByDecade[decade] %}
      <article class="card champion-card">
        <div class="card-body text-center">
          <div class="champion-year">{{ champion.year }}</div>
          <h3 class="champion-name">{{ champion.name }}</h3>
          {% if champion.title %}
          <p class="champion-title">{{ champion.title }}</p>
          {% endif %}
        </div>
      </article>
      {% endfor %}
    </div>
  </section>
  {% endfor %}
  {% else %}
  <div class="text-center py-12">
    <p class="text-muted">No champion data available.</p>
  </div>
  {% endif %}
</div>
{% endblock %}