{% extends 'layouts/base.njk' %}

{% block content %}
<div class="container">
  <header class="page-header">
    <h1 class="page-title">{{ pageTitle }}</h1>
    {% if pageSubtitle %}
    <p class="page-subtitle">{{ pageSubtitle }}</p>
    {% endif %}
  </header>

  <!-- Primary Ranks -->
  <section class="section">
    <h2 class="section-title">Primary Ranks</h2>

    {% if primaryRanks and primaryRanks.length > 0 %}
    <div class="accordion" id="primary-ranks">
      {% for rank in primaryRanks %}
      <div class="accordion-item">
        <button class="accordion-trigger" aria-expanded="false" aria-controls="rank-{{ rank.id }}">
          {{ rank.level }}: {{ rank.name }}
        </button>
        <div class="accordion-panel" id="rank-{{ rank.id }}" hidden>
          <div class="accordion-content">
            {% if rank.description %}
            <div class="rank-description">{{ rank.description | markdown }}</div>
            {% endif %}
            {% if rank.requirements %}
            <h4>Requirements:</h4>
            <ul>
              {% for req in rank.requirements %}
              <li>{{ req }}</li>
              {% endfor %}
            </ul>
            {% endif %}
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
    {% else %}
    <p class="text-muted">No primary ranks defined.</p>
    {% endif %}
  </section>

  <!-- Steel Ranks -->
  <section class="section">
    <h2 class="section-title">Steel Ranks</h2>

    {% if steelRanks and steelRanks.length > 0 %}
    <div class="accordion" id="steel-ranks">
      {% for rank in steelRanks %}
      <div class="accordion-item">
        <button class="accordion-trigger" aria-expanded="false" aria-controls="steel-rank-{{ rank.id }}">
          {{ rank.level }}: {{ rank.name }}
        </button>
        <div class="accordion-panel" id="steel-rank-{{ rank.id }}" hidden>
          <div class="accordion-content">
            {% if rank.description %}
            <div class="rank-description">{{ rank.description | markdown }}</div>
            {% endif %}
            {% if rank.requirements %}
            <h4>Requirements:</h4>
            <ul>
              {% for req in rank.requirements %}
              <li>{{ req }}</li>
              {% endfor %}
            </ul>
            {% endif %}
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
    {% else %}
    <p class="text-muted">No steel ranks defined.</p>
    {% endif %}
  </section>
</div>
{% endblock %}

{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('.accordion-trigger').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const panel = trigger.nextElementSibling;
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';

      // Close all other panels in the same accordion
      const accordion = trigger.closest('.accordion');
      if (accordion) {
        accordion.querySelectorAll('.accordion-trigger[aria-expanded="true"]').forEach((other) => {
          if (other !== trigger) {
            other.setAttribute('aria-expanded', 'false');
            other.nextElementSibling.hidden = true;
            other.nextElementSibling.style.maxHeight = '0';
          }
        });
      }

      trigger.setAttribute('aria-expanded', !isOpen);
      panel.hidden = isOpen;

      if (!isOpen) {
        panel.style.maxHeight = panel.scrollHeight + 'px';
      } else {
        panel.style.maxHeight = '0';
      }
    });
  });
});
</script>
{% endblock %}