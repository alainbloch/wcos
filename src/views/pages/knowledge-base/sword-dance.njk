{% extends 'layouts/base.njk' %}

{% block content %}
<div class="container">
  <header class="page-header">
    <h1 class="page-title">{{ pageTitle }}</h1>
  </header>

  {% if page and page.content %}
  <div class="card">
    <div class="card-body">
      <div class="prose">{{ page.content | markdown }}</div>
    </div>
  </div>
  {% else %}
  <div class="text-center py-12">
    <div class="mb-4" style="font-size: 4rem;">⚔️</div>
    <h2>{{ pageTitle }} - Content Coming Soon</h2>
    <p class="text-muted">This section is being prepared. Please check back later.</p>
    {% if user %}
    <a href="/admin/pages/new?slug={{ pageTitle | slugify }}" class="btn btn-primary mt-4">Create Content</a>
    {% endif %}
  </div>
  {% endif %}
</div>
{% endblock %}