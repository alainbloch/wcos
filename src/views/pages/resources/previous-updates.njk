{% extends 'layouts/base.njk' %}

{% block content %}
<div class="container">
  <header class="page-header">
    <h1 class="page-title">{{ pageTitle }}</h1>
  </header>

  {% if page and page.content %}
  <div class="card">
    <div class="card-body">
      <div class="prose">{{ page.content | markdown }}</div>
    </div>
  </div>
  {% else %}
  <div class="text-center py-12">
    <p class="text-muted">Previous updates and announcements will be listed here.</p>
    {% if user %}
    <a href="/admin/pages/new?slug=previous-updates" class="btn btn-primary mt-4">Create Content</a>
    {% endif %}
  </div>
  {% endif %}
</div>
{% endblock %}