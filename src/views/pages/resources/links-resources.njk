{% extends 'layouts/base.njk' %}

{% block content %}
<div class="container">
  <header class="page-header">
    <h1 class="page-title">{{ pageTitle }}</h1>
    {% if pageSubtitle %}
    <p class="page-subtitle">{{ pageSubtitle }}</p>
    {% endif %}
  </header>

  <div class="card mb-8">
    <div class="card-body">
      <p>There are many sources of arms and armor for sword fighters. A lot of products are cheaply made, only intended to look nice hanging on a wall or draped on you as you walk about a renaissance or fantasy faire or convention. For weapons, look for high carbon combat ready. For armor, stainless or spring steel, or thick aluminium or latigo leather. See our <a href="#">Protective Gear</a> page for more guidance.</p>
      <p>(Lists are alphabetical, check with your Kaiden if you're unsure on any particular product)</p>
    </div>
  </div>

  {% if resourcesGrouped %}
  {% for category in resourcesGrouped %}
  <section class="section">
    <div class="accordion-section mb-6">
      <button class="accordion-trigger category-trigger" aria-expanded="false" style="width: 100%; text-align: left; padding: var(--space-4); background: var(--color-surface-alt); border: 1px solid var(--color-border); border-radius: var(--radius-md); font-size: var(--font-size-lg); font-family: var(--font-heading); color: var(--color-primary);">
        {{ category }} ({{ resourcesGrouped[category].length }})
      </button>
      <div class="accordion-panel" hidden>
        <div style="padding: var(--space-4);">
          <ul style="list-style: none; padding: 0; columns: 2; column-gap: var(--space-8);">
            {% for resource in resourcesGrouped[category] %}
            <li style="break-inside: avoid; margin-bottom: var(--space-3);">
              {% if resource.url %}
              <a href="{{ resource.url }}" target="_blank" rel="noopener" class="resource-link" style="display: block; padding: var(--space-3); background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); transition: all var(--transition-fast);">
                <strong>{{ resource.name }}</strong>
                {% if resource.description %}
                <br><small class="text-muted">{{ resource.description }}</small>
                {% endif %}
              </a>
              {% else %}
              <strong>{{ resource.name }}</strong>
              {% if resource.description %}
              <br><small class="text-muted">{{ resource.description }}</small>
              {% endif %}
              {% endif %}
            </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </div>
  </section>
  {% endfor %}
  {% else %}
  <div class="text-center py-12">
    <p class="text-muted">No resources currently listed.</p>
  </div>
  {% endif %}
</div>
{% endblock %}

{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('.category-trigger').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const panel = trigger.nextElementSibling;
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';

      trigger.setAttribute('aria-expanded', !isOpen);
      panel.hidden = isOpen;

      if (!isOpen) {
        panel.style.maxHeight = panel.scrollHeight + 'px';
      } else {
        panel.style.maxHeight = '0';
      }
    });
  });
});
</script>
{% endblock %}