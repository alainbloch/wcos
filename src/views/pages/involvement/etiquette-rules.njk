{% extends 'layouts/base.njk' %}

{% block content %}
<div class="container">
  <header class="page-header">
    <h1 class="page-title">{{ pageTitle }}</h1>
  </header>

  <!-- Main Content -->
  {% if page and page.content %}
  <section class="section">
    <div class="card">
      <div class="card-body">
        <div class="prose">{{ page.content | markdown }}</div>
      </div>
    </div>
  </section>
  {% endif %}

  <!-- Three Rules of Swordsmanship -->
  {% if threeRules and threeRules.content %}
  <section class="section">
    <h2 class="section-title">Three Rules of Swordsmanship</h2>
    <div class="card">
      <div class="card-body">
        <div class="prose">{{ threeRules.content | markdown }}</div>
      </div>
    </div>
  </section>
  {% endif %}

  <!-- Six Traditions -->
  {% if sixTraditions and sixTraditions.content %}
  <section class="section">
    <h2 class="section-title">The Six Traditions</h2>
    <div class="card">
      <div class="card-body">
        <div class="prose">{{ sixTraditions.content | markdown }}</div>
      </div>
    </div>
  </section>
  {% endif %}

  <!-- WCoS Rules -->
  {% if wcosRules and wcosRules.content %}
  <section class="section">
    <h2 class="section-title">The Rules of the Western Circle</h2>
    <div class="card">
      <div class="card-body">
        <div class="prose">{{ wcosRules.content | markdown }}</div>
      </div>
    </div>
  </section>
  {% endif %}

  <!-- Sub-rules accordion -->
  <section class="section">
    <div class="accordion" id="sub-rules">
      {% if westernCircleRules and westernCircleRules.content %}
      <div class="accordion-item">
        <button class="accordion-trigger" aria-expanded="false" aria-controls="subrule-1">
          Western Circle of Swordfighters Rules
        </button>
        <div class="accordion-panel" id="subrule-1" hidden>
          <div class="accordion-content">{{ westernCircleRules.content | markdown }}</div>
        </div>
      </div>
      {% endif %}

      {% if kaidensRules and kaidensRules.content %}
      <div class="accordion-item">
        <button class="accordion-trigger" aria-expanded="false" aria-controls="subrule-2">
          Western Circle Kaidens' Rules
        </button>
        <div class="accordion-panel" id="subrule-2" hidden>
          <div class="accordion-content">{{ kaidensRules.content | markdown }}</div>
        </div>
      </div>
      {% endif %}

      {% if eventHostingRules and eventHostingRules.content %}
      <div class="accordion-item">
        <button class="accordion-trigger" aria-expanded="false" aria-controls="subrule-3">
          Event Hosting Rules
        </button>
        <div class="accordion-panel" id="subrule-3" hidden>
          <div class="accordion-content">{{ eventHostingRules.content | markdown }}</div>
        </div>
      </div>
      {% endif %}

      {% if eventRules and eventRules.content %}
      <div class="accordion-item">
        <button class="accordion-trigger" aria-expanded="false" aria-controls="subrule-4">
          Event Rules
        </button>
        <div class="accordion-panel" id="subrule-4" hidden>
          <div class="accordion-content">{{ eventRules.content | markdown }}</div>
        </div>
      </div>
      {% endif %}

      {% if combatRules and combatRules.content %}
      <div class="accordion-item">
        <button class="accordion-trigger" aria-expanded="false" aria-controls="subrule-5">
          Combat Rules
        </button>
        <div class="accordion-panel" id="subrule-5" hidden>
          <div class="accordion-content">{{ combatRules.content | markdown }}</div>
        </div>
      </div>
      {% endif %}
    </div>
  </section>
</div>
{% endblock %}

{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('#sub-rules .accordion-trigger').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const panel = trigger.nextElementSibling;
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';

      trigger.setAttribute('aria-expanded', !isOpen);
      panel.hidden = isOpen;

      if (!isOpen) {
        panel.style.maxHeight = panel.scrollHeight + 'px';
      } else {
        panel.style.maxHeight = '0';
      }
    });
  });
});
</script>
{% endblock %}