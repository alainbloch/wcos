{% extends 'layouts/base.njk' %}

{% block content %}
<div class="container">
  <header class="page-header">
    <h1 class="page-title">{{ pageTitle }}</h1>
    {% if pageSubtitle %}
    <p class="page-subtitle">{{ pageSubtitle }}</p>
    {% endif %}
  </header>

  {% if dues %}
  <section class="section">
    <div class="card">
      <div class="card-body">
        {% if dues.nonProfit %}
        <h3>Non-Profit</h3>
        <p>{{ dues.nonProfit }}</p>
        {% endif %}

        {% if dues.memberContributions %}
        <h3>Member Contributions</h3>
        <p>{{ dues.memberContributions }}</p>
        {% endif %}

        {% if dues.donateText %}
        <h3>{{ dues.donateText }}</h3>
        {% endif %}
      </div>
    </div>
  </section>

  <!-- Donation Form -->
  <section class="section">
    <div class="card">
      <div class="card-body">
        <form action="https://www.paypal.com/donate" method="post" target="_blank" class="donation-form">
          <input type="hidden" name="business" value="{{ dues.paypalEmail || 'westerncouncil@gmail.com' }}">
          <input type="hidden" name="currency_code" value="USD">

          <div class="form-row">
            <div class="form-group">
              <label for="amount">Dues Choices</label>
              <select name="amount" id="amount" class="form-select" required>
                {% for option in dues.amountOptions || ['50.00', '100.00'] %}
                <option value="{{ option }}">{{ option | float }} USD</option>
                {% endfor %}
              </select>
            </div>

            <div class="form-group">
              <label for="rank">Current Rank</label>
              <select name="custom" id="rank" class="form-select" required>
                {% for rank in dues.rankOptions || ['L1 - Trainee', 'L2 - Green Braid', 'L3 - White Rope', 'L4 - Red Rope', 'L5 - Crimson Chain', 'L6 - Silver Chain', 'L7 - Copper Chain'] %}
                <option value="{{ rank }}">{{ rank }}</option>
                {% endfor %}
              </select>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="dojo">Primary Dojo</label>
              <select name="item_name" id="dojo" class="form-select" required>
                {% for dojo in dues.dojoOptions || ['CA - Hayward', 'CA - Redding', 'CA - San Diego (Escondido)', 'KY - Louisville', 'NV - Gardnerville', 'OR - Portland (Beaverton)', 'WA - Seattle', 'Other/None'] %}
                <option value="{{ dojo }}">{{ dojo }}</option>
                {% endfor %}
              </select>
            </div>

            <div class="form-group">
              <label for="notes">Other Notes (optional)</label>
              <input type="text" name="item_number" id="notes" class="form-input" placeholder="Additional information">
            </div>
          </div>

          <button type="submit" class="btn btn-accent btn-lg mt-4">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm1-13h-2v6h2zm0 8h-2v2h2z"/></svg>
            Donate with PayPal
          </button>
        </form>
      </div>
    </div>
  </section>
  {% else %}
  <div class="text-center py-12">
    <p class="text-muted">Dues information not configured.</p>
  </div>
  {% endif %}
</div>
{% endblock %}