{% extends 'layouts/base.njk' %}

{% block content %}
<div class="container">
  <header class="page-header">
    <h1 class="page-title">{{ pageTitle }}</h1>
    {% if pageSubtitle %}
    <p class="page-subtitle">{{ pageSubtitle }}</p>
    {% endif %}
  </header>

  <div class="card mb-8">
    <div class="card-body">
      <p>Below are the locations of the regular WCoS classes. Each class is privately run and it is at the Kaiden's discretion when new students will be accepted.</p>
      <p>Due to COVID-19, the below class schedules, capacity, and class behaviors/precautions may be altered for the safety of instructors and students alike.</p>
    </div>
  </div>

  {% if classesGrouped %}
  {% for region in classesGrouped %}
  <section class="section">
    <h2 class="section-title">{{ region }}</h2>
    <div class="table-container">
      <table class="table">
        <thead>
          <tr>
            <th>Class Location</th>
            <th>Class Day</th>
            <th>Kaiden</th>
            <th>Class Description</th>
          </tr>
        </thead>
        <tbody>
          {% for cls in classesGrouped[region] %}
          <tr>
            <td><strong>{{ cls.location }}</strong></td>
            <td>{{ cls.day }}</td>
            <td>{{ cls.kaiden }}</td>
            <td>{{ cls.description }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
  {% endfor %}
  {% else %}
  <div class="text-center py-12">
    <p class="text-muted">No classes currently listed.</p>
  </div>
  {% endif %}

  <div class="card mt-8">
    <div class="card-body text-center">
      <p>If you are interested in any of the above classes, or would like additional information, please email us at <a href="mailto:{{ siteEmail }}">{{ siteEmail }}</a> or use our contact form and we will get you in contact with the Kaiden in your region.</p>
    </div>
  </div>
</div>
{% endblock %}