<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if pageTitle %}{{ pageTitle }} | {% endif %}{{ siteName }} - Admin</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link href="https://fonts.googleapis.com/css2?family=Anton:100,100italic,200,200italic,300,300italic,400,400italic,500,500italic,600,600italic,700,700italic,800,800italic,900,900italic&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Roboto:100,100italic,200,200italic,300,300italic,400,400italic,500,500italic,600,600italic,700,700italic,800,800italic,900,900italic&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Meow+Script:100,100italic,200,200italic,300,300italic,400,400italic,500,500italic,600,600italic,700,700italic,800,800italic,900,900italic&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css">
  {% block head %}{% endblock %}
</head>
<body>
  <div class="admin-layout">
    <aside class="admin-sidebar">
      <div class="admin-brand">
        <a href="/admin" class="admin-logo">
          <img src="/images/WCoS-Logo-1024x953.png" alt="WCoS" height="40">
          <span>WCoS Admin</span>
        </a>
      </div>
      <nav class="admin-nav">
        <ul>
          <li><a href="/admin" {% if request.path == '/admin' %}class="active"{% endif %}>📊 Dashboard</a></li>
          <li><a href="/admin/pages" {% if request.path.startsWith('/admin/pages') %}class="active"{% endif %}>📄 Pages</a></li>
          <li><a href="/admin/members" {% if request.path.startsWith('/admin/members') %}class="active"{% endif %}>👥 Members</a></li>
          {% if user and user.role === 'admin' %}
          <li><a href="/admin/settings" {% if request.path.startsWith('/admin/settings') %}class="active"{% endif %}>⚙️ Settings</a></li>
          {% endif %}
        </ul>
      </nav>
      <div class="admin-user">
        <span>{{ user.name }} ({{ user.role }})</span>
        <a href="/logout" class="btn btn-sm btn-outline">Logout</a>
      </div>
    </aside>

    <div class="admin-main">
      <header class="admin-header">
        <h1>{{ pageTitle }}</h1>
        <a href="/" target="_blank" class="btn btn-sm btn-outline">View Site</a>
      </header>

      <main class="admin-content">
        {% if flash.success %}
          <div class="alert alert-success">{{ flash.success }}</div>
        {% endif %}
        {% if flash.error %}
          <div class="alert alert-error">{{ flash.error }}</div>
        {% endif %}

        {% block content %}{% endblock %}
      </main>
    </div>
  </div>

  <script src="/js/admin.js" defer></script>
  {% block scripts %}{% endblock %}
</body>
</html>