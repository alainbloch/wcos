<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if pageTitle %}{{ pageTitle }} | {% endif %}{{ siteName }} - Admin</title>
  <link rel="icon" type="image/png" href="/favicon.png" sizes="192x192">
  <link rel="stylesheet" href="/css/admin.css">
  {% block head %}{% endblock %}
</head>
<body>
  <a href="#admin-content" class="skip-link">Skip to content</a>
  <div class="admin-layout">
    <aside class="admin-sidebar" id="admin-sidebar">
      <div class="admin-brand">
        <a href="/admin" class="admin-logo">
          <img src="/images/WCoS-Logo-1024x953.png" alt="WCoS" height="40">
          <span>WCoS Admin</span>
        </a>
      </div>
      <nav class="admin-nav" aria-label="Administration">
        <ul>
          <li><a href="/admin" {% if request.path == '/admin' %}class="active" aria-current="page"{% endif %}><span class="nav-mark" aria-hidden="true"></span> Overview</a></li>
          <li><a href="/admin/pages" {% if request.path.startsWith('/admin/pages') %}class="active" aria-current="page"{% endif %}><span class="nav-mark" aria-hidden="true"></span> Pages</a></li>
          <li><a href="/admin/glossary" {% if request.path.startsWith('/admin/glossary') %}class="active" aria-current="page"{% endif %}><span class="nav-mark" aria-hidden="true"></span> Glossary</a></li>
          <li><a href="/admin/moves" {% if request.path.startsWith('/admin/moves') %}class="active" aria-current="page"{% endif %}><span class="nav-mark" aria-hidden="true"></span> Moves</a></li>
          <li><a href="/admin/members" {% if request.path.startsWith('/admin/members') %}class="active" aria-current="page"{% endif %}><span class="nav-mark" aria-hidden="true"></span> Members</a></li>
          <li><a href="/admin/classes" {% if request.path.startsWith('/admin/classes') %}class="active" aria-current="page"{% endif %}><span class="nav-mark" aria-hidden="true"></span> Classes</a></li>
          <li><a href="/admin/updates" {% if request.path.startsWith('/admin/updates') %}class="active" aria-current="page"{% endif %}><span class="nav-mark" aria-hidden="true"></span> Updates</a></li>
          <li><a href="/admin/layout" {% if request.path.startsWith('/admin/layout') %}class="active" aria-current="page"{% endif %}><span class="nav-mark" aria-hidden="true"></span> Layout</a></li>
          <li><a href="/admin/users" {% if request.path.startsWith('/admin/users') %}class="active" aria-current="page"{% endif %}><span class="nav-mark" aria-hidden="true"></span> Users</a></li>
          <li><a href="/admin/collections" {% if request.path.startsWith('/admin/collections') %}class="active" aria-current="page"{% endif %}>Collections</a></li>
          <li><a href="/admin/data-views" {% if request.path.startsWith('/admin/data-views') %}class="active" aria-current="page"{% endif %}>Data Views</a></li>
          <li><a href="/admin/settings" {% if request.path.startsWith('/admin/settings') %}class="active" aria-current="page"{% endif %}><span class="nav-mark" aria-hidden="true"></span> Settings</a></li>
        </ul>
      </nav>
      <div class="admin-user">
        <span>{{ user.name }}<br><small>{{ user.role | capitalize }}</small></span>
        <a href="/logout" class="btn btn-sm btn-outline">Logout</a>
      </div>
    </aside>

    <div class="admin-main">
      <header class="admin-header">
        <div class="admin-heading"><span class="eyebrow">Website administration</span><h1>{{ pageTitle }}</h1></div>
        <a href="/" target="_blank" rel="noopener" class="btn btn-sm btn-outline">View Site</a>
      </header>

      <main class="admin-content" id="admin-content">
        {% if flash.success %}
          <div class="alert alert-success" role="status">{{ flash.success }}</div>
        {% endif %}
        {% if flash.error %}
          <div class="alert alert-error" role="alert">{{ flash.error }}</div>
        {% endif %}

        {% block content %}{% endblock %}
      </main>
    </div>
  </div>

  <script src="/js/admin.js" defer></script>
  {% block scripts %}{% endblock %}
</body>
</html>