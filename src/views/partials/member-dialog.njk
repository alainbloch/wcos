									<table border="1" cellspacing="2" cellpadding="3"><tbody><tr><td colspan="2"><table border="0" width="100%" cellspacing="3" cellpadding="0"><tbody><tr><td><b>Battle Ratings and Stats</b></td><td align="right" valign="top"><span style="color: #666666;">Updated 3/1/15</span></td></tr></tbody></table></td></tr><tr><td><span style="color: red;">Years Fought</span></td><td>in excess of 30</td></tr><tr><td><span style="color: red;">Battles Fought</span></td><td>in excess of 10,000</td></tr><tr><td><span style="color: red;">Steel Battles Fought</span></td><td>5,000</td></tr><tr><td><span style="color: red;">WCoS Ranking</span></td><td>L7</td></tr><tr><td><span style="color: red;">Steel Ranking</span></td><td>L6</td></tr><tr><td><span style="color: red;">Opponents Fought</span></td><td>In excess of 400</td></tr><tr><td><span style="color: red;">Weapon Type</span></td><td>Two handed broad sword</td></tr></tbody></table>								</div>
				<div class="elementor-element elementor-element-deefdc6 elementor-widget elementor-widget-heading" data-id="deefdc6" data-element_type="widget" data-e-type="widget" data-widget_type="heading.default">
