<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="{{ siteName }} - Home">
          <img src="/images/WCoS-Logo-1024x953.png" alt="{{ siteName }}" width="120" height="115">
          <span>{{ siteName }}</span>
        </a>
        <p class="footer-tagline">Preserving the art of swordsmanship through discipline, honor, and community.</p>
      </div>

      <div class="footer-links">
        <h3>Who We Are</h3>
        <ul>
          {% for item in navigation.whoWeAre %}
          <li><a href="/{{ item.slug }}">{{ item.label }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <div class="footer-links">
        <h3>Knowledge Base</h3>
        <ul>
          {% for item in navigation.knowledgeBase %}
          <li><a href="/{{ item.slug }}">{{ item.label }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <div class="footer-links">
        <h3>Involvement</h3>
        <ul>
          {% for item in navigation.involvement %}
          <li><a href="/{{ item.slug }}">{{ item.label }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <div class="footer-links">
        <h3>Resources</h3>
        <ul>
          {% for item in navigation.resources %}
          <li><a href="/{{ item.slug }}">{{ item.label }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <div class="footer-contact">
        <h3>Contact</h3>
        <a href="mailto:{{ siteEmail }}" class="contact-email">{{ siteEmail }}</a>
        <p class="contact-dojos">{{ dojosText }}</p>
        <div class="footer-social">
          <a href="{{ social.facebook }}" target="_blank" rel="noopener" aria-label="Facebook">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
          <a href="{{ social.instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
          <a href="{{ social.youtube }}" target="_blank" rel="noopener" aria-label="YouTube">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {{ currentYear }} {{ siteName }}. All rights reserved.</p>
      <p class="footer-credit">Powered by <a href="https://ventnorweb.com" target="_blank" rel="noopener">Ventnor Web Agency</a></p>
    </div>
  </div>
</footer>