<header class="site-header" role="banner">
  <!-- Top Bar -->
  <div class="header-top">
    <div class="container">
      <div class="header-contact">
        <a href="mailto:{{ siteEmail }}" class="contact-email">{{ siteEmail }}</a>
        <span class="contact-dojos">{{ dojosText }}</span>
      </div>
      <div class="header-social">
        <a href="{{ social.facebook }}" target="_blank" rel="noopener" aria-label="Facebook">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
        </a>
        <a href="{{ social.instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        </a>
        <a href="{{ social.youtube }}" target="_blank" rel="noopener" aria-label="YouTube">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navigation -->
  <nav class="main-nav" role="navigation" aria-label="Main navigation">
    <div class="container nav-container">
      <a href="/" class="logo" aria-label="{{ siteName }} - Home">
        <img src="/images/WCoS-Logo-1024x953.png" alt="{{ siteName }}" width="120" height="115">
        <span class="logo-text">{{ siteName }}</span>
      </a>

      <button class="mobile-menu-toggle" aria-expanded="false" aria-controls="nav-menu" aria-label="Toggle menu">
        <span class="hamburger"></span>
      </button>

      <div id="nav-menu" class="nav-menu">
        <div class="search-form" role="search">
          <label for="search-input" class="visually-hidden">Search</label>
          <input type="search" id="search-input" placeholder="Search..." class="search-input">
          <button type="submit" class="search-btn" aria-label="Search">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
          </button>
        </div>

        <ul class="nav-list">
          <li class="nav-item has-dropdown">
            <button class="nav-link dropdown-toggle" aria-expanded="false" aria-haspopup="true">WHO WE ARE</button>
            <ul class="dropdown-menu" role="menu">
              {% for item in navigation.whoWeAre %}
              <li role="none"><a href="/{{ item.slug }}" class="dropdown-item" role="menuitem">{{ item.label }}</a></li>
              {% endfor %}
            </ul>
          </li>

          <li class="nav-item has-dropdown">
            <button class="nav-link dropdown-toggle" aria-expanded="false" aria-haspopup="true">KNOWLEDGE BASE</button>
            <ul class="dropdown-menu" role="menu">
              {% for item in navigation.knowledgeBase %}
              <li role="none"><a href="/{{ item.slug }}" class="dropdown-item" role="menuitem">{{ item.label }}</a></li>
              {% endfor %}
            </ul>
          </li>

          <li class="nav-item has-dropdown">
            <button class="nav-link dropdown-toggle" aria-expanded="false" aria-haspopup="true">INVOLVEMENT</button>
            <ul class="dropdown-menu" role="menu">
              {% for item in navigation.involvement %}
              <li role="none"><a href="/{{ item.slug }}" class="dropdown-item" role="menuitem">{{ item.label }}</a></li>
              {% endfor %}
            </ul>
          </li>

          <li class="nav-item has-dropdown">
            <button class="nav-link dropdown-toggle" aria-expanded="false" aria-haspopup="true">RESOURCES</button>
            <ul class="dropdown-menu" role="menu">
              {% for item in navigation.resources %}
              <li role="none"><a href="/{{ item.slug }}" class="dropdown-item" role="menuitem">{{ item.label }}</a></li>
              {% endfor %}
            </ul>
          </li>

          {% if user %}
          <li class="nav-item"><a href="/admin" class="nav-link">Admin</a></li>
          <li class="nav-item"><a href="/logout" class="nav-link">Logout</a></li>
          {% else %}
          <li class="nav-item"><a href="/login" class="nav-link">Login</a></li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>

  <!-- Hero Banner -->
  <div class="hero-banner">
    <div class="container">
      <h1 class="hero-title">{{ heroTitle }}</h1>
      <p class="hero-subtitle">{{ heroSubtitle }}</p>
    </div>
  </div>
</header>