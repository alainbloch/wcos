{# Keep the restored six-column roster structure; only member values are dynamic. #}
{% for member in members %}
<div class="elementor-element elementor-element-b615446 e-con-full table-row e-flex e-con e-child" data-id="b615446" data-element_type="container" data-e-type="container" data-member-id="{{ member.id }}">
		<div class="elementor-element elementor-element-57fb69a e-con-full e-flex e-con e-child" data-id="57fb69a" data-element_type="container" data-e-type="container">
		<div class="elementor-element elementor-element-78efa67 e-con-full e-flex e-con e-child" data-id="78efa67" data-element_type="container" data-e-type="container">
		<div class="elementor-element elementor-element-4ec73df e-con-full e-flex e-con e-child" data-id="4ec73df" data-element_type="container" data-e-type="container">
				<div class="elementor-element elementor-element-4eb9f87 elementor-widget elementor-widget-heading" data-id="4eb9f87" data-element_type="widget" data-e-type="widget" data-widget_type="heading.default">
					<p class="elementor-heading-title elementor-size-default">{{ member.level }}</p>				</div>
				</div>
				<div class="elementor-element elementor-element-3f6d94c elementor-widget-divider--view-line elementor-widget elementor-widget-divider" data-id="3f6d94c" data-element_type="widget" data-e-type="widget" data-widget_type="divider.default">
							<div class="elementor-divider">
			<span class="elementor-divider-separator">
						</span>
		</div>
						</div>
		<div class="elementor-element elementor-element-7d95a37 e-con-full e-flex e-con e-child" data-id="7d95a37" data-element_type="container" data-e-type="container">
				<div class="elementor-element elementor-element-a9d6a92 elementor-widget elementor-widget-heading" data-id="a9d6a92" data-element_type="widget" data-e-type="widget" data-widget_type="heading.default">
					<p class="elementor-heading-title elementor-size-default">{{ member.steelRank or member.circleName }}</p>				</div>
				</div>
				</div>
				</div>
		<div class="elementor-element elementor-element-3b7507e e-con-full e-flex e-con e-child" data-id="3b7507e" data-element_type="container" data-e-type="container">
				<div class="elementor-element elementor-element-d109b11 elementor-widget elementor-widget-image" data-id="d109b11" data-element_type="widget" data-e-type="widget" data-widget_type="image.default">
															<img decoding="async" width="47" height="50" src="{{ member.image }}" class="attachment-full size-full wp-image-381" alt="{{ member.position }}" data-member-portrait="{{ member.position }}">															</div>
				</div>
		<div class="elementor-element elementor-element-11835d3 e-con-full e-flex e-con e-child" data-id="11835d3" data-element_type="container" data-e-type="container">
				<div class="elementor-element elementor-element-3c38739 elementor-widget elementor-widget-heading" data-id="3c38739" data-element_type="widget" data-e-type="widget" data-widget_type="heading.default">
					<p class="elementor-heading-title elementor-size-default">{% if member.position == 'Gad' %}<a href="#member-gad" data-member-dialog="member-gad">{{ member.position }}</a>{% else %}{{ member.position }}{% endif %}</p>{% if member.biography %}<details><summary>Profile</summary><p>{{ member.biography }}</p></details>{% endif %}				</div>
				</div>
		<div class="elementor-element elementor-element-340db23 e-con-full e-flex e-con e-child" data-id="340db23" data-element_type="container" data-e-type="container">{% for merit in member.merits %}<div class="elementor-element elementor-element-c3764e0 elementor-widget elementor-widget-heading" data-id="c3764e0" data-element_type="widget" data-e-type="widget" data-widget_type="heading.default">
					<p class="elementor-heading-title elementor-size-default">{{ merit }}</p>				</div>{% endfor %}</div>
		<div class="elementor-element elementor-element-6011ac0 e-con-full e-flex e-con e-child" data-id="6011ac0" data-element_type="container" data-e-type="container">
				<div class="elementor-element elementor-element-1b9ce12 elementor-widget elementor-widget-heading" data-id="1b9ce12" data-element_type="widget" data-e-type="widget" data-widget_type="heading.default">
					<p class="elementor-heading-title elementor-size-default">{{ member.memberSince }}</p>				</div>
				</div>
		<div class="elementor-element elementor-element-e4361d8 e-con-full e-flex e-con e-child" data-id="e4361d8" data-element_type="container" data-e-type="container">
				<div class="elementor-element elementor-element-f45ec86 elementor-widget elementor-widget-heading" data-id="f45ec86" data-element_type="widget" data-e-type="widget" data-widget_type="heading.default">
					<p class="elementor-heading-title elementor-size-default">{{ member.region }}</p>				</div>
				</div>
				</div>
{% else %}
<div class="member-empty"><p>No active members to display.</p></div>
{% endfor %}
