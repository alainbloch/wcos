{% extends 'layouts/admin.njk' %}
{% block content %}
<form method="post" action="{% if item.id %}/admin/updates/{{ item.id }}/edit{% else %}/admin/updates{% endif %}" class="admin-form page-editor" data-page-editor data-preview-url="/admin/updates/preview" data-unsaved="{% if flash.error %}true{% else %}false{% endif %}" enctype="multipart/form-data">
<input type="hidden" name="_csrf" value="{{ csrf }}">
<section class="admin-card update-details"><h2>Update details</h2><div class="form-row"><div class="form-group"><label for="title">Title (optional)</label><input id="title" name="title" value="{{ item.title }}" maxlength="200"></div>
<div class="form-group"><label for="date">Date</label><input id="date" name="date" value="{{ item.date }}" required pattern="[0-9]{4}-[0-9]{2}(-[0-9]{2})?" placeholder="YYYY-MM-DD" aria-describedby="date-help"><small id="date-help">Use YYYY-MM-DD, or YYYY-MM when only the month is known.</small></div>
<div class="form-group">
  <label for="category">Category (required)</label>
  <select id="category" name="category" required>
    <option value="general" {% if item.category == 'general' %}selected{% endif %}>General Update</option>
    <option value="council" {% if item.category == 'council' %}selected{% endif %}>Council</option>
    <option value="news" {% if item.category == 'news' %}selected{% endif %}>News</option>
  </select>
</div>
<div class="form-group"><label for="subcategory">Subcategory (optional)</label><input id="subcategory" name="subcategory" value="{{ item.subcategory }}" list="subcategory-list" maxlength="100"><datalist id="subcategory-list">{% for sc in subcategories %}<option value="{{ sc }}">{% endfor %}</datalist><small>Choose an existing subcategory or enter a new one.</small></div>
<div class="form-group"><label for="pageLink">Page Link (optional)</label><select id="pageLink" name="pageLink"><option value="">None</option>{% for p in pages %}<option value="{{ p.slug }}" {% if item.pageLink == p.slug %}selected{% endif %}>{{ p.title }} ({{ p.slug }})</option>{% endfor %}</select></div>
<div class="form-group"><label for="image">Image (optional)</label><input id="image" name="image" type="file" accept="image/*">{% if item.image %}<div class="upload-preview"><img src="{{ item.image }}" alt="Current update image"><a href="{{ item.image }}" target="_blank" rel="noopener">View current image ↗</a></div>{% endif %}</div>
</div></section><section class="admin-card"><h2>Content</h2><div class="editor-toolbar"><button type="button" class="btn" data-editor-mode="source">HTML source</button><button type="button" class="btn" data-editor-mode="visual">Visual editor</button></div><p data-editor-status role="status"></p>
<div data-visual-panel hidden><div class="editor-toolbar">{% for command,label in [['bold','Bold'],['italic','Italic'],['h2','Heading'],['p','Paragraph'],['insertUnorderedList','Bullet list'],['createLink','Link'],['undo','Undo']] %}<button type="button" class="editor-btn" data-command="{{ command }}">{{ label }}</button>{% endfor %}</div><iframe class="editor-frame" title="Update body editor" sandbox="allow-same-origin"></iframe></div>
<label for="content" data-source-label>HTML body</label><textarea id="content" name="content" class="source-editor" rows="24" maxlength="200000">{{ item.body }}</textarea>
<p data-save-status role="status">{% if flash.error %}Unsaved changes{% else %}All changes saved{% endif %}</p><button class="btn btn-primary">Save update</button> <a class="btn" href="/admin/updates">Back to updates</a></section>
</form>
{% endblock %}
