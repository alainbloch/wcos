{% extends 'layouts/admin.njk' %}
{% block content %}
<form method="post" action="{% if item.id %}/admin/updates/{{ item.id }}/edit{% else %}/admin/updates{% endif %}" class="admin-form page-editor" data-page-editor data-preview-url="/admin/updates/preview" data-unsaved="{% if flash.error %}true{% else %}false{% endif %}">
<input type="hidden" name="_csrf" value="{{ csrf }}">
<div class="form-group"><label for="title">Title (optional)</label><input id="title" name="title" value="{{ item.title }}" maxlength="200"></div>
<div class="form-group"><label for="date">Date</label><input id="date" name="date" value="{{ item.date }}" required pattern="[0-9]{4}-[0-9]{2}(-[0-9]{2})?" placeholder="YYYY-MM-DD" aria-describedby="date-help"><small id="date-help">Use YYYY-MM-DD, or YYYY-MM when only the month is known.</small></div>
<div class="form-group"><label for="category">Category</label><select id="category" name="category" required><option value="general" {% if item.category == 'general' %}selected{% endif %}>General Update</option><option value="council" {% if item.category == 'council' %}selected{% endif %}>Council</option></select></div>
<section class="admin-card"><div class="editor-toolbar"><button type="button" class="btn" data-editor-mode="source">HTML source</button><button type="button" class="btn" data-editor-mode="visual">Visual editor</button></div><p data-editor-status role="status"></p>
<div data-visual-panel hidden><div class="editor-toolbar">{% for command,label in [['bold','Bold'],['italic','Italic'],['h2','Heading'],['p','Paragraph'],['insertUnorderedList','Bullet list'],['createLink','Link'],['undo','Undo']] %}<button type="button" class="editor-btn" data-command="{{ command }}">{{ label }}</button>{% endfor %}</div><iframe class="editor-frame" title="Update body editor" sandbox="allow-same-origin"></iframe></div>
<label for="content" data-source-label>HTML body</label><textarea id="content" name="content" class="source-editor" rows="24" maxlength="200000">{{ item.body }}</textarea>
<p data-save-status role="status">{% if flash.error %}Unsaved changes{% else %}All changes saved{% endif %}</p><button class="btn btn-primary">Save update</button> <a class="btn" href="/admin/updates">Back to updates</a></section>
</form>
{% endblock %}
