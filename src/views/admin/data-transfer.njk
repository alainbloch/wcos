{% extends 'layouts/admin.njk' %}
{% block content %}
<div class="page-heading"><a class="btn" href="/admin/settings">← Back to Settings</a></div>
<p>Transfer database records and uploaded images or videos. Backup files contain personal data and password hashes; keep them private.</p>
<div class="dashboard-grid transfer-grid">
<section class="admin-card"><h2>Export</h2>
<p>Choose the collections to include. JSON contains records, IDs, and relationships. ZIP also includes uploaded media.</p>
<form method="get" action="/admin/settings/data-transfer/export/json" data-transfer-export>
<input type="hidden" name="selection" value="custom">
<fieldset><legend>Collections</legend>
<div class="actions"><button type="button" class="btn" data-export-select="all">Select all</button><button type="button" class="btn" data-export-select="none">Clear selection</button></div>
{% for collection in exportCollections %}
<label class="check-label"><input type="checkbox" name="collections" value="{{ collection.key }}" checked> {{ collection.label }}</label>
{% endfor %}
</fieldset>
<p>Partial exports support Populate and Override. Restore requires all collections. Include Members when transferring Classes or Moves to another database so instructor and creator IDs can be resolved.</p>
<div class="actions"><button class="btn btn-primary" type="submit">Export Data (.json)</button><button class="btn" type="submit" formaction="/admin/settings/data-transfer/export/zip">Export Archive (.zip)</button></div>
<p data-export-status role="status"></p>
</form>
<p>Partial ZIPs include only uploads referenced by the selected records; full ZIPs include all uploads. Built-in images stay with the application and external media URLs remain links. Users includes password hashes. Sessions and environment secrets are excluded.</p></section>
<section class="admin-card"><h2>Import</h2>
<form data-transfer-upload class="admin-form">
<input type="hidden" name="_csrf" value="{{ csrf }}">
<div class="form-group"><label for="backup-file">JSON or ZIP file</label><input id="backup-file" name="file" type="file" accept=".json,.zip" required></div>
<div class="form-group"><label for="import-mode">Import mode</label><select id="import-mode" name="mode"><option value="populate">Populate — add missing records</option><option value="override">Override — replace matching IDs and add new records</option><option value="restore">Restore — replace the entire database</option></select></div>
<p>Populate keeps existing records. Override retains records absent from the file. Restore deletes records absent from the file; a ZIP restore also replaces uploaded media. JSON imports keep existing uploads and report missing files. Site settings are treated as one shared record.</p>
<button class="btn btn-primary" type="submit">Validate and preview</button><p data-transfer-status role="status"></p>
<noscript>Enable JavaScript to upload a backup. Export and confirmation forms remain available.</noscript>
</form><small>Limits: 128 MiB file, 256 MiB expanded content, 5,000 archive entries. Previews expire after 30 minutes.</small></section>
</div>
{% if report %}
<section class="admin-card"><h2>Import preview: {{ report.mode | capitalize }}</h2>
{% for warning in report.warnings %}<p>{{ warning }}</p>{% endfor %}
{% if report.errors.length %}<div class="alert alert-error" role="alert"><h3>Import blocked</h3><p>Correct these errors and upload again. No changes have been applied.</p><ul>{% for error in report.errors %}<li>{{ error }}</li>{% endfor %}</ul></div>{% endif %}
<div class="admin-table-container"><table class="admin-table"><thead><tr><th>Collection</th><th>Add</th><th>Replace</th><th>Keep / skip</th><th>Remove</th><th>Result total</th></tr></thead><tbody>{% for count in report.counts %}<tr><td>{{ count.collection }}</td><td>{{ count.added }}</td><td>{{ count.replaced }}</td><td>{{ count.skipped }}</td><td>{{ count.removed }}</td><td>{{ count.total }}</td></tr>{% endfor %}</tbody></table></div>
{% if report.mediaChanges.length %}<h3>Media changes</h3><div class="admin-table-container"><table class="admin-table"><thead><tr><th>Action</th><th>File</th><th>Result path</th></tr></thead><tbody>{% for file in report.mediaChanges %}<tr><td>{{ file.action }}</td><td>{{ file.source }}</td><td>{{ file.target }}</td></tr>{% endfor %}</tbody></table></div>{% endif %}
{% if report.token and not report.errors.length %}<form method="post" action="/admin/settings/data-transfer/apply" class="admin-form"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="token" value="{{ report.token }}"><label class="check-label"><input type="checkbox" name="confirm" value="yes" required> I reviewed these changes and can sign in with an account in the resulting database.</label><p>A complete recovery archive will be created before applying. You will sign in again afterward.</p><button class="btn btn-danger" type="submit">Apply import</button></form>{% endif %}
</section>{% endif %}
<section class="admin-card"><h2>Recovery archives</h2><p>Created automatically before each import; stored privately on the server.</p><ul>{% for name in backups %}<li><a href="/admin/settings/data-transfer/backups/{{ name }}">{{ name }}</a></li>{% else %}<li>No recovery archives yet.</li>{% endfor %}</ul></section>
{% endblock %}
{% block scripts %}<script src="/js/data-transfer.js" defer></script>{% endblock %}
