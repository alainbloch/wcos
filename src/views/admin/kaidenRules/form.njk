{% extends 'layouts/admin.njk' %}

{% block content %}
<div class="admin-content">
  <div class="flex justify-between items-center mb-6">
    <h2>{% if kaidenRule %}Edit Kaiden Rule{% else %}New Kaiden Rule{% endif %}</h2>
    <a href="/admin/kaiden-rules" class="btn btn-secondary">← Back to Kaiden Rules</a>
  </div>

  {% if flash %}
  <div class="flash flash-{{ flash.type }} mb-4">{{ flash.message }}</div>
  {% endif %}

  <form method="POST" action="{% if kaidenRule %}/admin/kaiden-rules/{{ kaidenRule.id }}/edit{% else %}/admin/kaiden-rules{% endif %}" class="admin-form">
    <div class="form-grid">
      <fieldset class="form-section">
        <legend>Kaiden Rule Information</legend>

        <div class="form-field">
          <label for="order">Order <span class="required">*</span></label>
          <input type="number" id="order" name="order" value="{{ kaidenRule.order or 0 }}" required min="0" placeholder="Display order">
        </div>

        <div class="form-field">
          <label for="title">Title <span class="required">*</span></label>
          <input type="text" id="title" name="title" value="{{ kaidenRule.title or '' }}" required placeholder="Rule title">
        </div>

        <div class="form-field form-section-full">
          <label for="content">Content <span class="required">*</span></label>
          <textarea id="content" name="content" rows="6" required placeholder="Rule description and details...">{{ kaidenRule.content or '' }}</textarea>
          <small class="form-hint">Full rule content. Markdown supported.</small>
        </div>
      </fieldset>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">{% if kaidenRule %}Update Kaiden Rule{% else %}Create Kaiden Rule{% endif %}</button>
      <a href="/admin/kaiden-rules" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div>
{% endblock %}