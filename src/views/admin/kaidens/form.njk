{% extends 'layouts/admin.njk' %}

{% block content %}
<div class="admin-content">
  <div class="flex justify-between items-center mb-6">
    <h2>{% if kaiden %}Edit Kaiden{% else %}New Kaiden{% endif %}</h2>
    <a href="/admin/kaidens" class="btn btn-secondary">← Back to Kaidens</a>
  </div>

  {% if flash %}
  <div class="flash flash-{{ flash.type }} mb-4">{{ flash.message }}</div>
  {% endif %}

  <form method="POST" action="{% if kaiden %}/admin/kaidens/{{ kaiden.id }}/edit{% else %}/admin/kaidens{% endif %}" class="admin-form">
    <div class="form-grid">
      <fieldset class="form-section">
        <legend>Kaiden Information</legend>

        <div class="form-field">
          <label for="title">Title <span class="required">*</span></label>
          <input type="text" id="title" name="title" value="{{ kaiden.title or '' }}" required placeholder="e.g., The Way of the Sword, 1st Kaiden Document">
        </div>

        <div class="form-field">
          <label for="section">Section <span class="required">*</span></label>
          <select id="section" name="section" required>
            <option value="">Select Section</option>
            <option value="theWay" {% if kaiden.section == 'theWay' %}selected{% endif %}>The Way</option>
            <option value="documents" {% if kaiden.section == 'documents' %}selected{% endif %}>Documents</option>
            <option value="other" {% if kaiden.section == 'other' %}selected{% endif %}>Other</option>
          </select>
        </div>

        <div class="form-field">
          <label for="slug">Slug <span class="required">*</span></label>
          <input type="text" id="slug" name="slug" value="{{ kaiden.slug or '' }}" required placeholder="url-friendly-slug">
          <small class="form-hint">Lowercase letters, numbers, and hyphens only</small>
        </div>

        <div class="form-field form-section-full">
          <label for="content">Content</label>
          <textarea id="content" name="content" rows="10" placeholder="Full content for this Kaiden section...">{{ kaiden.content or '' }}</textarea>
          <small class="form-hint">Markdown supported</small>
        </div>
      </fieldset>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">{% if kaiden %}Update Kaiden{% else %}Create Kaiden{% endif %}</button>
      <a href="/admin/kaidens" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div>
{% endblock %}