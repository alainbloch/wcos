{% extends 'layouts/admin.njk' %}

{% block content %}
<div class="admin-content">
  <div class="flex justify-between items-center mb-6">
    <h2>{% if dalmaterColor %}Edit Dalmater Color{% else %}New Dalmater Color{% endif %}</h2>
    <a href="/admin/dalmater-colors" class="btn btn-secondary">← Back to Dalmater Colors</a>
  </div>

  {% if flash %}
  <div class="flash flash-{{ flash.type }} mb-4">{{ flash.message }}</div>
  {% endif %}

  <form method="POST" action="{% if dalmaterColor %}/admin/dalmater-colors/{{ dalmaterColor.id }}/edit{% else %}/admin/dalmater-colors{% endif %}" class="admin-form">
    <div class="form-grid">
      <fieldset class="form-section">
        <legend>Dalmater Color Information</legend>

        <div class="form-field">
          <label for="color">Color (Hex) <span class="required">*</span></label>
          <input type="color" id="color" name="color" value="{{ dalmaterColor.color or '#000000' }}" required>
          <input type="text" id="colorHex" name="colorHex" value="{{ dalmaterColor.color or '' }}" placeholder="#RRGGBB" style="margin-top: 4px;">
          <small class="form-hint">Select color or enter hex value</small>
        </div>

        <div class="form-field">
          <label for="kaiden">Kaiden</label>
          <input type="text" id="kaiden" name="kaiden" value="{{ dalmaterColor.kaiden or '' }}" placeholder="e.g., 1st Kaiden, 2nd Kaiden, Red Dalmater">
        </div>

        <div class="form-field">
          <label for="kaidenOrder">Kaiden Order</label>
          <input type="number" id="kaidenOrder" name="kaidenOrder" value="{{ dalmaterColor.kaidenOrder or 0 }}" min="0" placeholder="Display order">
        </div>

        <div class="form-field checkbox-field">
          <input type="checkbox" id="isRedDalmater" name="isRedDalmater" {% if dalmaterColor.isRedDalmater %}checked{% endif %}>
          <label for="isRedDalmater">Red Dalmater</label>
        </div>

        <div class="form-field checkbox-field">
          <input type="checkbox" id="active" name="active" {% if dalmaterColor.active !== false %}checked{% endif %}>
          <label for="active">Active</label>
        </div>

        <div class="form-field form-section-full">
          <label for="description">Description</label>
          <textarea id="description" name="description" rows="3" placeholder="Significance, history, requirements...">{{ dalmaterColor.description or '' }}</textarea>
        </div>
      </fieldset>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">{% if dalmaterColor %}Update Dalmater Color{% else %}Create Dalmater Color{% endif %}</button>
      <a href="/admin/dalmater-colors" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div>
{% endblock %}