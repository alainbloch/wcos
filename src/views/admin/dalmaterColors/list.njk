{% extends 'layouts/admin.njk' %}

{% block content %}
<div class="admin-content">
  <div class="flex justify-between items-center mb-6">
    <h2>Dalmater Colors</h2>
    <a href="/admin/dalmater-colors/new" class="btn btn-primary">+ Add Dalmater Color</a>
  </div>

  <div class="notice">Manage dalmater colors and their Kaiden associations. Displayed on the Dalmater Colors knowledge base page.</div>
  {% if dalmaterColors and dalmaterColors.length > 0 %}
  <div class="admin-table-container">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Color</th>
          <th>Kaiden</th>
          <th>Order</th>
          <th>Red Dalmater</th>
          <th>Active</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for color in dalmaterColors %}
        <tr>
          <td>
            {% if color.color %}
            <span class="color-swatch" style="background-color: {{ color.color }};"></span>
            {{ color.color }}
            {% else %}
            -
            {% endif %}
          </td>
          <td>{{ color.kaiden or '-' }}</td>
          <td>{{ color.kaidenOrder or 0 }}</td>
          <td>
            {% if color.isRedDalmater %}
            <span class="badge badge-danger">Yes</span>
            {% else %}
            <span class="badge badge-muted">No</span>
            {% endif %}
          </td>
          <td>
            {% if color.active !== false %}
            <span class="badge badge-success">Active</span>
            {% else %}
            <span class="badge badge-muted">Inactive</span>
            {% endif %}
          </td>
          <td class="actions-cell">
            <a href="/admin/dalmater-colors/{{ color.id }}/edit" class="btn btn-sm btn-secondary" title="Edit">✏️ Edit</a>
            <form method="POST" action="/admin/dalmater-colors/{{ color.id }}/delete" class="inline-form" onsubmit="return confirm('Delete {{ color.color }}? This cannot be undone.');">
              <button type="submit" class="btn btn-sm btn-danger" title="Delete">🗑️ Delete</button>
            </form>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% else %}
  <div class="text-center py-12">
    <p class="text-muted">No dalmater colors yet.</p>
    <a href="/admin/dalmater-colors/new" class="btn btn-primary mt-4">+ Add First Dalmater Color</a>
  </div>
  {% endif %}
</div>
{% endblock %}