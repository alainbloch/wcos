{% extends 'layouts/admin.njk' %}

{% block content %}
<div class="admin-content">
  <div class="flex justify-between items-center mb-6">
    <h2>Member records</h2>
    <div class="flex gap-2">
      {% if memberPage %}<a href="/admin/pages/{{ memberPage.id }}/edit" class="btn btn-secondary">Edit public member profiles page</a>{% endif %}
      <a href="/admin/members/new" class="btn btn-primary">+ Add Member</a>
    </div>
  </div>

  <div class="notice">Manage member records below. The public Member Profiles page displays active members grouped by level.</div>
  {% if members and members.length > 0 %}
  <div class="admin-table-container">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Level</th>
          <th>Steel Rank</th>
          <th>Circle Name</th>
          <th>Position</th>
          <th>Merits</th>
          <th>Member Since</th>
          <th>Region</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for member in members %}
        <tr>
          <td><strong>{{ member.level }}</strong></td>
          <td>{{ member.steelRank or '-' }}</td>
          <td>{{ member.position }}</td>
          <td>{{ member.circleName }}</td>
          <td>
            {% if member.merits and member.merits.length > 0 %}
              <span class="merits-list">{{ member.merits.join(', ') }}</span>
            {% else %}
              <span class="text-muted">—</span>
            {% endif %}
          </td>
          <td>{{ member.memberSince or '-' }}</td>
          <td>{{ member.region or '-' }}</td>
          <td>
            {% if member.active %}
              <span class="badge badge-success">Active</span>
            {% else %}
              <span class="badge badge-muted">Inactive</span>
            {% endif %}
          </td>
          <td class="actions-cell">
            <a href="/admin/members/{{ member.id }}/edit" class="btn btn-sm btn-secondary" title="Edit">✏️ Edit</a>
            <form method="POST" action="/admin/members/{{ member.id }}/delete" class="inline-form" onsubmit="return confirm('Delete {{ member.position }}? This cannot be undone.');">
              <button type="submit" class="btn btn-sm btn-danger" title="Delete">🗑️ Delete</button>
            </form>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% else %}
  <div class="text-center py-12">
    <p class="text-muted">No members yet.</p>
    <a href="/admin/members/new" class="btn btn-primary mt-4">+ Add First Member</a>
  </div>
  {% endif %}
</div>
{% endblock %}