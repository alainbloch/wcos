{% extends 'layouts/admin.njk' %}

{% block content %}
<div class="admin-content">
  <div class="flex justify-between items-center mb-6">
    <h2>Members</h2>
    <a href="/admin/members/new" class="btn btn-primary">Add Member</a>
  </div>

  {% if members and members.length > 0 %}
  <div class="admin-table-container">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Level</th>
          <th>Circle Name</th>
          <th>Position & Merits</th>
          <th>Member Since</th>
          <th>Region</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for member in members %}
        <tr>
          <td><strong>{{ member.level }}</strong></td>
          <td>{{ member.circleName }}</td>
          <td>{{ member.position }}</td>
          <td>{{ member.memberSince }}</td>
          <td>{{ member.region }}</td>
          <td class="actions">
            <a href="/admin/members/{{ member.id }}/edit" class="btn btn-sm btn-outline">Edit</a>
            <form action="/admin/members/{{ member.id }}/delete" method="POST" style="display: inline;">
              <button type="submit" class="btn btn-sm btn-outline" style="color: var(--color-primary);" data-confirm-delete="Delete '{{ member.circleName }}'?">Delete</button>
            </form>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% else %}
  <div class="text-center py-12">
    <p class="text-muted">No members yet.</p>
    <a href="/admin/members/new" class="btn btn-primary mt-4">Add First Member</a>
  </div>
  {% endif %}
</div>
{% endblock %}