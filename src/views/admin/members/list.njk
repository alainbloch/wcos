{% extends 'layouts/admin.njk' %}

{% block content %}
{% if honorsReview.length %}<details class="notice"><summary>Hall of Heroes migration: {{ honorsReview.length }} records need review</summary><ul>{% for issue in honorsReview %}<li>{{ issue.reason }} — {{ issue.record.name }}{% if issue.record.year %} ({{ issue.record.year }}){% endif %}</li>{% endfor %}</ul><p>The original records are retained in the migration backup.</p></details>{% endif %}
<div class="admin-content">
  <div class="page-heading">

    <div class="flex gap-2">
      {% if memberPage %}<a href="/admin/pages/{{ memberPage.id }}/edit" class="btn btn-secondary">Edit public member profiles page</a>{% endif %}
      <a href="/admin/members/new" class="btn btn-primary">+ Add Member</a>
    </div>
  </div>

  <div class="notice">Manage member records below. The public Member Profiles page displays active members grouped by level.</div>
  <form method="GET" action="/admin/members" class="filter-bar">
    <div class="filter-field"><label for="council-filter">Council service</label>
    <select id="council-filter" name="council">
      <option value="" {% if not councilFilter %}selected{% endif %}>All members</option>
      <option value="all" {% if councilFilter == 'all' %}selected{% endif %}>All council members (past and current)</option>
      <option value="current" {% if councilFilter == 'current' %}selected{% endif %}>Current council members</option>
    </select></div>
    <button type="submit" class="btn btn-secondary">Filter</button>
  </form>
  {% if members and members.length > 0 %}
  <div class="admin-table-container">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Level</th>
          <th>Steel Rank</th>
          <th>Circle Name</th>
          <th>Position</th>
          <th>Merits</th>
          <th>Member Since</th>
          <th>Region</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for member in members %}
        <tr>
          <td><strong>{{ member.level }}</strong></td>
          <td>{{ member.steelRank or '-' }}</td>
          <td>{{ member.position }}</td>
          <td>{{ member.circleName }}</td>
          <td>
            {% if member.merits and member.merits.length > 0 %}
              <span class="merits-list">{% if member.merits is string %}{{ member.merits }}{% else %}{{ member.merits | join(', ') }}{% endif %}</span>
            {% else %}
              <span class="text-muted">—</span>
            {% endif %}
          </td>
          <td>{{ member.memberSince or '-' }}</td>
          <td>{{ member.region or '-' }}</td>
          <td>
            {% if member.active %}
              <span class="badge badge-success">Active</span>
            {% else %}
              <span class="badge badge-muted">Inactive</span>
            {% endif %}
          </td>
          <td class="actions-cell">
            <a href="/admin/members/{{ member.id }}/edit" class="btn btn-sm btn-secondary" title="Edit">Edit</a>
            <form method="POST" action="/admin/members/{{ member.id }}/delete" class="inline-form" onsubmit="return confirm('Delete {{ member.position }}? This cannot be undone.');">
              <button type="submit" class="btn btn-sm btn-danger" title="Delete">Delete</button>
            </form>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% else %}
  <div class="text-center py-12">
    <p class="text-muted">No members match this view.</p>
    <a href="/admin/members/new" class="btn btn-primary mt-4">+ Add First Member</a>
  </div>
  {% endif %}
</div>
{% endblock %}
