{% extends 'layouts/admin.njk' %}

{% block content %}
<div class="admin-content">
  <div class="flex justify-between items-center mb-6">
    <h2>Member records</h2>
    {% if memberPage %}<a href="/admin/pages/{{ memberPage.id }}/edit" class="btn btn-primary">Edit public member profiles</a>{% endif %}
  </div>

  <div class="notice">Public profiles are managed on the Member Profiles page. The records below are a read-only reference from the earlier import.</div>
  {% if members and members.length > 0 %}
  <div class="admin-table-container">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Level</th>
          <th>Circle Name</th>
          <th>Position & Merits</th>
          <th>Member Since</th>
          <th>Region</th>

        </tr>
      </thead>
      <tbody>
        {% for member in members %}
        <tr>
          <td><strong>{{ member.level }}</strong></td>
          <td>{{ member.circleName }}</td>
          <td>{{ member.position }}</td>
          <td>{{ member.memberSince }}</td>
          <td>{{ member.region }}</td>

        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% else %}
  <div class="text-center py-12">
    <p class="text-muted">No members yet.</p>

  </div>
  {% endif %}
</div>
{% endblock %}