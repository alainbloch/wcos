{% extends 'layouts/admin.njk' %}

{% block content %}
<div class="admin-content">
  <div class="flex justify-between items-center mb-6">
    <h2>{% if member %}Edit Member{% else %}New Member{% endif %}</h2>
    <a href="/admin/members" class="btn btn-secondary">← Back to Members</a>
  </div>

  {% if flash %}
  <div class="flash flash-{{ flash.type }} mb-4">{{ flash.message }}</div>
  {% endif %}

  <form method="POST" action="{% if member %}/admin/members/{{ member.id }}/edit{% else %}/admin/members{% endif %}" class="admin-form" enctype="multipart/form-data">
    <div class="form-grid">
      <!-- Basic Info -->
      <fieldset class="form-section">
        <legend>Basic Information</legend>
        
        <div class="form-field">
          <label for="circleName">Circle Name <span class="required">*</span></label>
          <input type="text" id="circleName" name="circleName" value="{{ member.circleName or '' }}" required placeholder="e.g., Gad, Steel Wind">
          <small class="form-hint">The member's circle/fighter name (e.g., "Gad", "Steel Wind")</small>
        </div>

        <div class="form-field">
          <label for="level">Level <span class="required">*</span></label>
          <select id="level" name="level" required>
            <option value="">Select Level</option>
            <option value="L7" {% if member.level == 'L7' %}selected{% endif %}>L7</option>
            <option value="L6" {% if member.level == 'L6' %}selected{% endif %}>L6</option>
            <option value="L5" {% if member.level == 'L5' %}selected{% endif %}>L5</option>
            <option value="L4" {% if member.level == 'L4' %}selected{% endif %}>L4</option>
            <option value="L3" {% if member.level == 'L3' %}selected{% endif %}>L3</option>
            <option value="L2" {% if member.level == 'L2' %}selected{% endif %}>L2</option>
            <option value="L1" {% if member.level == 'L1' %}selected{% endif %}>L1</option>
          </select>
        </div>

        <div class="form-field">
          <label for="steelRank">Steel Rank</label>
          <select id="steelRank" name="steelRank">
            <option value="">Select Steel Rank</option>
            <option value="L7" {% if member.steelRank == 'L7' %}selected{% endif %}>L7</option>
            <option value="L6" {% if member.steelRank == 'L6' %}selected{% endif %}>L6</option>
            <option value="L5" {% if member.steelRank == 'L5' %}selected{% endif %}>L5</option>
            <option value="L4" {% if member.steelRank == 'L4' %}selected{% endif %}>L4</option>
            <option value="L3" {% if member.steelRank == 'L3' %}selected{% endif %}>L3</option>
            <option value="L2" {% if member.steelRank == 'L2' %}selected{% endif %}>L2</option>
            <option value="L1" {% if member.steelRank == 'L1' %}selected{% endif %}>L1</option>
          </select>
          <small class="form-hint">Current steel/dalmater rank (may differ from level)</small>
        </div>

        <div class="form-field">
          <label for="position">Position / Title</label>
          <input type="text" id="position" name="position" value="{{ member.position or '' }}" placeholder="e.g., Expert Swordsman, Proficient Swordsman">
          <small class="form-hint">Primary position/title (will be added to merits)</small>
        </div>

        <div class="form-field">
          <label for="merits">Merits & Titles</label>
          <textarea id="merits" name="merits" rows="3" placeholder="One per line: Expert Swordsman, Kaiden, Council, Medical Officer, Webmaster">{% if member.merits is string %}{{ member.merits }}{% else %}{{ (member.merits or []) | join('\n') }}{% endif %}</textarea>
          <small class="form-hint">All merits/titles, one per line (includes position if not specified above)</small>
        </div>
      </fieldset>

      <!-- Dates & Status -->
      <fieldset class="form-section">
        <legend>Dates & Status</legend>
        
        <div class="form-field">
          <label for="memberSince">Member Since</label>
          <input type="text" id="memberSince" name="memberSince" value="{{ member.memberSince or '' }}" placeholder="e.g., Aug 1982, 2004, Spring 1992">
          <small class="form-hint">Year or approximate date joined</small>
        </div>

        <div class="form-field">
          <label for="region">Region / Location</label>
          <input type="text" id="region" name="region" value="{{ member.region or '' }}" placeholder="e.g., Hayward, CA; Seattle, WA; Beaverton, OR">
          <small class="form-hint">City, State or general region</small>
        </div>

        <div class="form-field checkbox-field">
          <input type="checkbox" id="active" name="active" {% if member.active != false %}checked{% endif %}>
          <label for="active">Active Member</label>
        </div>
      </fieldset>

<fieldset class="form-section form-section-full"><legend>Public profile details</legend><p>Optional details shown in the member’s profile modal. Leave unknown values blank.</p><div class="form-field"><label for="email">Public email</label><input type="email" id="email" name="email" value="{{ member.email or '' }}"></div><div class="form-field"><label for="yearsFought">Years fought</label><input type="text" id="yearsFought" name="yearsFought" value="{{ member.yearsFought or '' }}"></div><div class="form-field"><label for="battlesFought">Battles fought</label><input type="text" id="battlesFought" name="battlesFought" value="{{ member.battlesFought or '' }}"></div><div class="form-field"><label for="steelBattlesFought">Steel battles fought</label><input type="text" id="steelBattlesFought" name="steelBattlesFought" value="{{ member.steelBattlesFought or '' }}"></div><div class="form-field"><label for="opponentsFought">Opponents fought</label><input type="text" id="opponentsFought" name="opponentsFought" value="{{ member.opponentsFought or '' }}"></div><div class="form-field"><label for="weaponType">Weapon type</label><input type="text" id="weaponType" name="weaponType" value="{{ member.weaponType or '' }}"></div><div class="form-field"><label for="statsUpdated">Statistics last updated</label><input type="text" id="statsUpdated" name="statsUpdated" value="{{ member.statsUpdated or '' }}"></div></fieldset>
      <!-- Biography & Media -->
      <fieldset class="form-section form-section-full">
        <legend>Biography & Media</legend>
        
        <div class="form-field">
          <label for="biography">Biography</label>
          <textarea id="biography" name="biography" rows="6" placeholder="Member biography, achievements, history...">{{ member.biography or '' }}</textarea>
          <small class="form-hint">Shown in the click-to-open profile modal. Markdown supported.</small>
        </div>

        <div class="form-field">
          <label for="image">Profile Image</label>
          <input type="text" id="image" name="image" value="{{ member.image or '' }}" placeholder="/images/filename.jpg">
          <small class="form-hint">Path to profile image in /public/images/ (e.g., /images/gad.jpg). Leave blank for no image.</small>
        </div>

        {% if member and member.image %}
        <div class="form-field">
          <label>Current Image Preview</label>
          <div class="image-preview">
            <img src="{{ member.image }}" alt="{{ member.position }}" style="max-width: 150px; max-height: 150px;">
          </div>
        </div>
        {% endif %}
      </fieldset>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">{% if member %}Update Member{% else %}Create Member{% endif %}</button>
      <a href="/admin/members" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div>
{% endblock %}