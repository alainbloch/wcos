{% extends 'layouts/admin.njk' %}

{% block content %}
<div class="admin-content">
  <div class="flex justify-between items-center mb-6">
    <h2>{% if member.id %}Edit Member{% else %}New Member{% endif %}</h2>
    <a href="/admin/members" class="btn btn-secondary">← Back to Members</a>
  </div>

  <form method="POST" action="{% if member.id %}/admin/members/{{ member.id }}/edit{% else %}/admin/members{% endif %}" class="admin-form" enctype="multipart/form-data">
    <div class="form-grid">
      <!-- Basic Info -->
      <fieldset class="form-section">
        <legend>Basic Information</legend>
        
        <div class="form-field">
          <label for="circleName">Circle Name <span class="required">*</span></label>
          <input type="text" id="circleName" name="circleName" value="{{ member.circleName or '' }}" required placeholder="e.g., Gad, Steel Wind">
          <small class="form-hint">The member's circle/fighter name (e.g., "Gad", "Steel Wind")</small>
        </div>

        <div class="form-field">
          <label for="level">Level <span class="required">*</span></label>
          <select id="level" name="level" required>
            <option value="">Select Level</option>
            <option value="L7" {% if member.level == 'L7' %}selected{% endif %}>L7</option>
            <option value="L6" {% if member.level == 'L6' %}selected{% endif %}>L6</option>
            <option value="L5" {% if member.level == 'L5' %}selected{% endif %}>L5</option>
            <option value="L4" {% if member.level == 'L4' %}selected{% endif %}>L4</option>
            <option value="L3" {% if member.level == 'L3' %}selected{% endif %}>L3</option>
            <option value="L2" {% if member.level == 'L2' %}selected{% endif %}>L2</option>
            <option value="L1" {% if member.level == 'L1' %}selected{% endif %}>L1</option>
          </select>
        </div>

        <div class="form-field">
          <label for="steelRank">Steel Rank</label>
          <select id="steelRank" name="steelRank">
            <option value="">Select Steel Rank</option>
            <option value="L7" {% if member.steelRank == 'L7' %}selected{% endif %}>L7</option>
            <option value="L6" {% if member.steelRank == 'L6' %}selected{% endif %}>L6</option>
            <option value="L5" {% if member.steelRank == 'L5' %}selected{% endif %}>L5</option>
            <option value="L4" {% if member.steelRank == 'L4' %}selected{% endif %}>L4</option>
            <option value="L3" {% if member.steelRank == 'L3' %}selected{% endif %}>L3</option>
            <option value="L2" {% if member.steelRank == 'L2' %}selected{% endif %}>L2</option>
            <option value="L1" {% if member.steelRank == 'L1' %}selected{% endif %}>L1</option>
          </select>
          <small class="form-hint">Current steel/dalmater rank (may differ from level)</small>
        </div>

        <div class="form-field">
          <label for="position">Position / Title</label>
          <input type="text" id="position" name="position" value="{{ member.position or '' }}" placeholder="e.g., Expert Swordsman, Proficient Swordsman">
          <small class="form-hint">Primary position/title (will be added to merits)</small>
        </div>

        <div class="form-field">
          <label for="merits">Merits & Titles</label>
          <textarea id="merits" name="merits" rows="3" placeholder="One per line: Expert Swordsman, Kaiden, Council, Medical Officer, Webmaster">{% if member.merits is string %}{{ member.merits }}{% else %}{{ (member.merits or []) | join('\n') }}{% endif %}</textarea>
          <small class="form-hint">All merits/titles, one per line (includes position if not specified above)</small>
        </div>
      </fieldset>

      <!-- Dates & Status -->
      <fieldset class="form-section">
        <legend>Dates & Status</legend>
        
        <div class="form-field">
          <label for="memberSince">Member Since</label>
          <input type="text" id="memberSince" name="memberSince" value="{{ member.memberSince or '' }}" placeholder="e.g., Aug 1982, 2004, Spring 1992">
          <small class="form-hint">Year or approximate date joined</small>
        </div>

        <div class="form-field">
          <label for="region">Region / Location</label>
          <input type="text" id="region" name="region" value="{{ member.region or '' }}" placeholder="e.g., Hayward, CA; Seattle, WA; Beaverton, OR">
          <small class="form-hint">City, State or general region</small>
        </div>

        <div class="form-field checkbox-field">
          <input type="checkbox" id="active" name="active" {% if member.active != false %}checked{% endif %}>
          <label for="active">Active Member</label>
        </div>
      </fieldset>

<fieldset class="form-section form-section-full"><legend>Public profile details</legend><p>Optional details shown in the member’s profile modal. Leave unknown values blank.</p><div class="form-field"><label for="email">Public email</label><input type="email" id="email" name="email" value="{{ member.email or '' }}"></div><div class="form-field"><label for="yearsFought">Years fought</label><input type="text" id="yearsFought" name="yearsFought" value="{{ member.yearsFought or '' }}"></div><div class="form-field"><label for="battlesFought">Battles fought</label><input type="text" id="battlesFought" name="battlesFought" value="{{ member.battlesFought or '' }}"></div><div class="form-field"><label for="steelBattlesFought">Steel battles fought</label><input type="text" id="steelBattlesFought" name="steelBattlesFought" value="{{ member.steelBattlesFought or '' }}"></div><div class="form-field"><label for="opponentsFought">Opponents fought</label><input type="text" id="opponentsFought" name="opponentsFought" value="{{ member.opponentsFought or '' }}"></div><div class="form-field"><label for="weaponType">Weapon type</label><input type="text" id="weaponType" name="weaponType" value="{{ member.weaponType or '' }}"></div><div class="form-field"><label for="statsUpdated">Statistics last updated</label><input type="text" id="statsUpdated" name="statsUpdated" value="{{ member.statsUpdated or '' }}"></div></fieldset>
      <fieldset class="form-section form-section-full">
        <legend>Council Service</legend>
        <p>Keep shared biography and image details in the member profile. Record the latest council term here; dates may be approximate. Current status is set explicitly, independently of Active Member.</p>
        <div class="form-field"><label for="councilPosition">Council position</label><input type="text" id="councilPosition" name="councilPosition" value="{{ member.councilPosition or '' }}" placeholder="President, Secretary, Council member"></div>
        <div class="form-field"><label for="councilTitle">Council title</label><input type="text" id="councilTitle" name="councilTitle" value="{{ member.councilTitle or '' }}" placeholder="Kaiden"></div>
        <div class="form-field"><label for="councilTermStart">Term start</label><input type="text" id="councilTermStart" name="councilTermStart" value="{{ member.councilTermStart or '' }}" placeholder="2024 or January 2024"></div>
        <div class="form-field"><label for="councilTermEnd">Term end</label><input type="text" id="councilTermEnd" name="councilTermEnd" value="{{ member.councilTermEnd or '' }}" placeholder="2026 or December 2026"></div>
        <div class="form-field"><label for="councilHistoricalDate">Historical council date</label><input type="text" id="councilHistoricalDate" name="councilHistoricalDate" value="{{ member.councilHistoricalDate or '' }}" placeholder="2022-10-19"></div>
        <div class="form-field checkbox-field"><input type="checkbox" id="councilCurrent" name="councilCurrent" {% if member.councilCurrent %}checked{% endif %}><label for="councilCurrent">Current council member</label></div>
        {% if member.councilHistory.length %}
        <details><summary>Imported council history</summary><p>Original terms preserved during consolidation. Edit current details above.</p><ul>
          {% for term in member.councilHistory %}<li>{{ term.councilPosition or term.councilTitle or 'Council service' }}: {{ term.councilTermStart or term.councilHistoricalDate or 'Start unknown' }} — {{ term.councilTermEnd or 'End unknown' }}{% if term.councilCurrent %} (marked current when imported){% endif %}</li>{% endfor %}
        </ul></details>
        {% endif %}
      </fieldset>
      <fieldset class="form-section form-section-full" data-dalmater-fields>
        <legend>Dalmater Color</legend>
        <div class="form-field">
          <label for="dalmaterMode">Color source</label>
          <select id="dalmaterMode" name="dalmaterMode">
            <option value="" {% if not member.dalmaterMode %}selected{% endif %}>No color assigned</option>
            <option value="kaiden" {% if member.dalmaterMode == 'kaiden' %}selected{% endif %}>Choose a Kaiden's color</option>
            <option value="custom" {% if member.dalmaterMode == 'custom' %}selected{% endif %}>Custom color</option>
          </select>
        </div>
        <div class="form-field" data-dalmater-kaiden>
          <label for="dalmaterKaidenId">Kaiden color</label>
          <select id="dalmaterKaidenId" name="dalmaterKaidenId">
            <option value="">Select a Kaiden</option>
            {% if member.dalmaterMode == 'kaiden' and member.dalmaterKaidenId %}<option value="{{ member.dalmaterKaidenId }}" selected>Saved selection: {{ member.dalmaterColorName or 'Kaiden color' }} {{ member.dalmaterColorHex }}</option>{% endif %}
            {% for option in kaidenColorOptions %}<option value="{{ option.id }}">{{ option.name }} — {{ option.colorName }} ({{ option.colorHex }})</option>{% endfor %}
          </select>
          <small class="form-hint">Includes Kaiden, Head Kaiden, and Honorary Kaiden merits with a complete color. The selection copies their color when saved; later changes to the Kaiden do not change yours.</small>
        </div>
        <div data-dalmater-custom>
          <div class="form-field"><label for="dalmaterColorName">Color name</label><input id="dalmaterColorName" name="dalmaterColorName" type="text" value="{{ member.dalmaterColorName or '' }}" placeholder="Jade Green"></div>
          <div class="form-field"><label for="dalmaterColorHex">Hex color</label><input id="dalmaterColorHex" name="dalmaterColorHex" type="text" value="{{ member.dalmaterColorHex or '' }}" placeholder="#RRGGBB" spellcheck="false"><small class="form-hint">Enter #RRGGBB or #RGB.</small></div>
        </div>
        {% if member.dalmaterColorName and not member.dalmaterColorHex %}<p class="notice">This migrated color has a name but no recorded hex value. Add the correct shade when known. It cannot be offered in the Kaiden dropdown until then.</p>{% endif %}
        {% if member.dalmaterLegacyRecords.length %}<details><summary>Imported color history</summary><ul>{% for color in member.dalmaterLegacyRecords %}<li>{{ color.kaiden }}: {{ color.colorName or color.color }} {{ color.colorHex }}{% if color.description %} — {{ color.description }}{% endif %}</li>{% endfor %}</ul></details>{% endif %}
      </fieldset>
      <!-- Biography & Media -->
      <fieldset class="form-section form-section-full">
        <legend>Biography & Media</legend>
        
        <div class="form-field">
          <label for="biography">Biography</label>
          <textarea id="biography" name="biography" rows="6" placeholder="Member biography, achievements, history...">{{ member.biography or '' }}</textarea>
          <small class="form-hint">Shown in the click-to-open profile modal. Markdown supported.</small>
        </div>

        <div class="form-field">
          <label for="image">Profile Image</label>
          <input type="file" id="image" name="image" accept="image/jpeg,image/png,image/webp,image/gif">
          <small class="form-hint">Choose a JPEG, PNG, WebP, or GIF image. Leave blank to keep the current image.</small>
        </div>

        {% if member and member.image %}
        <div class="form-field">
          <label>Current Image Preview</label>
          <div class="image-preview">
            <img src="{{ member.image }}" alt="{{ member.circleName }}" style="max-width: 150px; max-height: 150px;">
          </div>
        </div>
        {% endif %}
      </fieldset>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">{% if member.id %}Update Member{% else %}Create Member{% endif %}</button>
      <a href="/admin/members" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div>
{% endblock %}