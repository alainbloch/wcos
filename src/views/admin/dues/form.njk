{% extends 'layouts/admin.njk' %}

{% block content %}
<div class="admin-content">
  <div class="flex justify-between items-center mb-6">
    <h2>{% if dues %}Edit Dues/Donation{% else %}New Dues/Donation{% endif %}</h2>
    <a href="/admin/dues" class="btn btn-secondary">← Back to Dues</a>
  </div>

  {% if flash %}
  <div class="flash flash-{{ flash.type }} mb-4">{{ flash.message }}</div>
  {% endif %}

  <form method="POST" action="{% if dues %}/admin/dues/{{ dues.id }}/edit{% else %}/admin/dues{% endif %}" class="admin-form">
    <div class="form-grid">
      <fieldset class="form-section">
        <legend>Dues/Donation Information</legend>

        <div class="form-field">
          <label for="title">Title <span class="required">*</span></label>
          <input type="text" id="title" name="title" value="{{ dues.title or '' }}" required placeholder="e.g., Annual Dues, Monthly Donation, Lifetime Membership">
        </div>

        <div class="form-field">
          <label for="amount">Amount</label>
          <input type="number" id="amount" name="amount" value="{{ dues.amount or '' }}" step="0.01" min="0" placeholder="e.g., 50, 10.00">
          <small class="form-hint">Leave blank for variable amount</small>
        </div>

        <div class="form-field">
          <label for="interval">Interval</label>
          <select id="interval" name="interval">
            <option value="">Select Interval</option>
            <option value="monthly" {% if dues.interval == 'monthly' %}selected{% endif %}>Monthly</option>
            <option value="quarterly" {% if dues.interval == 'quarterly' %}selected{% endif %}>Quarterly</option>
            <option value="annually" {% if dues.interval == 'annually' %}selected{% endif %}>Annually</option>
            <option value="one-time" {% if dues.interval == 'one-time' %}selected{% endif %}>One-time</option>
          </select>
        </div>

        <div class="form-field form-section-full">
          <label for="description">Description</label>
          <textarea id="description" name="description" rows="4" placeholder="What this covers, payment instructions, etc.">{{ dues.description or '' }}</textarea>
        </div>

        <div class="form-field">
          <label for="paymentUrl">Payment URL</label>
          <input type="url" id="paymentUrl" name="paymentUrl" value="{{ dues.paymentUrl or '' }}" placeholder="https://paypal.me/... or https://venmo.com/...">
        </div>

        <div class="form-field checkbox-field">
          <input type="checkbox" id="active" name="active" {% if dues.active %}checked{% endif %}>
          <label for="active">Active (show on public page)</label>
        </div>
      </fieldset>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">{% if dues %}Update Dues/Donation{% else %}Create Dues/Donation{% endif %}</button>
      <a href="/admin/dues" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div>
{% endblock %}