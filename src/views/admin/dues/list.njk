{% extends 'layouts/admin.njk' %}

{% block content %}
<div class="admin-content">
  <div class="flex justify-between items-center mb-6">
    <h2>Dues & Donations</h2>
    <a href="/admin/dues/new" class="btn btn-primary">+ Add Dues/Donation</a>
  </div>

  <div class="notice">Manage dues and donation options. The first active entry is used as the default on the public page.</div>
  {% if dues and dues.length > 0 %}
  <div class="admin-table-container">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Title</th>
          <th>Amount</th>
          <th>Interval</th>
          <th>Description</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for due in dues %}
        <tr>
          <td><strong>{{ due.title }}</strong></td>
          <td>{{ due.amount ? '$' + due.amount : '-' }}</td>
          <td>{{ due.interval or '-' }}</td>
          <td>{{ due.description ? due.description.substring(0, 60) + '...' : '-' }}</td>
          <td>
            {% if due.active %}
            <span class="badge badge-success">Active</span>
            {% else %}
            <span class="badge badge-muted">Inactive</span>
            {% endif %}
          </td>
          <td class="actions-cell">
            <a href="/admin/dues/{{ due.id }}/edit" class="btn btn-sm btn-secondary" title="Edit">✏️ Edit</a>
            <form method="POST" action="/admin/dues/{{ due.id }}/delete" class="inline-form" onsubmit="return confirm('Delete {{ due.title }}? This cannot be undone.');">
              <button type="submit" class="btn btn-sm btn-danger" title="Delete">🗑️ Delete</button>
            </form>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% else %}
  <div class="text-center py-12">
    <p class="text-muted">No dues/donations yet.</p>
    <a href="/admin/dues/new" class="btn btn-primary mt-4">+ Add First Dues/Donation</a>
  </div>
  {% endif %}
</div>
{% endblock %}