{% extends 'layouts/admin.njk' %}
{% block content %}
<div class="page-heading"><div><h2>Website settings</h2><p>Update your site identity and find the pages that control your public content.</p></div></div>
<div class="dashboard-grid"><section class="admin-card"><h2>Data Transfer</h2><p>Export data or full archives, validate imports, and restore backups.</p><a class="btn btn-primary" href="/admin/settings/data-transfer">Open Data Transfer</a></section><section class="admin-card"><h2>Site identity</h2><form action="/admin/settings" method="POST" class="admin-form" data-validate><div class="form-group"><label for="siteName">Site name</label><input id="siteName" name="siteName" value="{{ siteSettings.siteName }}" required><small>Used in website titles and page descriptions.</small></div><div class="form-actions"><button class="btn btn-primary">Save settings</button></div></form></section><section class="admin-card"><h2>Looking to change content?</h2>{% if homePage %}<a class="quick-link" href="/admin/pages/{{ homePage.id }}/edit">Homepage<small>Hero heading, introduction, and homepage sections</small></a>{% endif %}{% if contactPage %}<a class="quick-link" href="/admin/pages/{{ contactPage.id }}/edit">Contact page<small>Contact information displayed to visitors</small></a>{% endif %}<a class="quick-link" href="/admin/pages">All pages<small>Member profiles, classes, news, and knowledge base</small></a><p class="text-muted">Edit shared navigation and styling in <a href="/admin/layout">Layout</a>.</p></section></div>
{% endblock %}