{% extends 'layouts/admin.njk' %}

{% block content %}
<div class="admin-content">
  <div class="flex justify-between items-center mb-6">
    <h2>Champions (Hall of Heroes)</h2>
    <a href="/admin/champions/new" class="btn btn-primary">+ Add Champion</a>
  </div>

  <div class="notice">Manage Hall of Heroes champions. Champions are displayed by year on the public page.</div>
  {% if champions and champions.length > 0 %}
  <div class="admin-table-container">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Year</th>
          <th>Name</th>
          <th>Title</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for champion in champions %}
        <tr>
          <td><strong>{{ champion.year }}</strong></td>
          <td>{{ champion.name }}</td>
          <td>{{ champion.title or '-' }}</td>
          <td class="actions-cell">
            <a href="/admin/champions/{{ champion.id }}/edit" class="btn btn-sm btn-secondary" title="Edit">✏️ Edit</a>
            <form method="POST" action="/admin/champions/{{ champion.id }}/delete" class="inline-form" onsubmit="return confirm('Delete {{ champion.name }} ({{ champion.year }})? This cannot be undone.');">
              <button type="submit" class="btn btn-sm btn-danger" title="Delete">🗑️ Delete</button>
            </form>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% else %}
  <div class="text-center py-12">
    <p class="text-muted">No champions yet.</p>
    <a href="/admin/champions/new" class="btn btn-primary mt-4">+ Add First Champion</a>
  </div>
  {% endif %}
</div>
{% endblock %}