<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; script-src 'none'; form-action 'none'; base-uri 'none'"><link rel="stylesheet" href="/css/fonts.css">{% for stylesheet in styles %}<link rel="stylesheet" href="{{ stylesheet }}">{% endfor %}<link rel="stylesheet" href="/css/reference.css"><link rel="stylesheet" href="/css/data-views.css"><style>body{margin:0}#editable-content{min-height:450px;padding:20px;outline:none}#editable-content:focus{outline:2px solid #7297ca;outline-offset:-2px}#editable-content:empty:before{content:'Start writing your page…';color:#888}#editable-content img{max-width:100%}</style></head><body class="{{ bodyClass }} reference-site"><main id="editable-content">{{ content | safe }}</main></body></html>