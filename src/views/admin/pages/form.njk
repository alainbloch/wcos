{% extends 'layouts/admin.njk' %}

{% block content %}
<div class="admin-content">
  <form action="{% if page %}/admin/pages/{{ page.id }}/edit{% else %}/admin/pages{% endif %}" method="POST" class="admin-form" data-validate>
    <div class="form-group">
      <label for="title">Title</label>
      <input type="text" id="title" name="title" class="form-input" value="{{ page.title if page else '' }}" required>
    </div>

    <div class="form-group">
      <label for="slug">Slug</label>
      <input type="text" id="slug" name="slug" class="form-input" value="{{ page.slug if page else '' }}" required>
      <small class="text-muted">URL-friendly identifier (auto-generated from title if empty)</small>
    </div>

    <div class="form-group">
      <label for="content">Content</label>
      <div class="rich-editor">
        <div class="editor-toolbar">
          <button type="button" class="editor-btn" data-format="bold" title="Bold"><strong>B</strong></button>
          <button type="button" class="editor-btn" data-format="italic" title="Italic"><em>I</em></button>
          <button type="button" class="editor-btn" data-format="underline" title="Underline"><u>U</u></button>
          <button type="button" class="editor-btn" data-format="strike" title="Strikethrough"><s>S</s></button>
          <div style="width: 1px; background: var(--color-border); margin: 0 var(--space-2);"></div>
          <button type="button" class="editor-btn" data-format="ul" title="Unordered List">• List</button>
          <button type="button" class="editor-btn" data-format="ol" title="Ordered List">1. List</button>
          <div style="width: 1px; background: var(--color-border); margin: 0 var(--space-2);"></div>
          <button type="button" class="editor-btn" data-format="h2" title="Heading 2">H2</button>
          <button type="button" class="editor-btn" data-format="h3" title="Heading 3">H3</button>
          <button type="button" class="editor-btn" data-format="p" title="Paragraph">P</button>
          <div style="width: 1px; background: var(--color-border); margin: 0 var(--space-2);"></div>
          <button type="button" class="editor-btn" data-format="blockquote" title="Blockquote">❝</button>
          <button type="button" class="editor-btn" data-format="code" title="Code Block">{ }</button>
          <button type="button" class="editor-btn" data-format="removeFormat" title="Remove Formatting">T<sub>x</sub></button>
        </div>
        <div class="editor-content" contenteditable="true"></div>
      </div>
      <textarea name="content" style="display: none;">{{ page.content if page else '' }}</textarea>
    </div>

    <div class="form-group">
      <label class="flex items-center gap-2">
        <input type="checkbox" name="published" {% if page and page.published %}checked{% endif %}>
        <span>Published</span>
      </label>
    </div>

    <div class="form-actions">
      <a href="/admin/pages" class="btn btn-outline">Cancel</a>
      <button type="submit" class="btn btn-primary">{% if page %}Update{% else %}Create{% endif %} Page</button>
    </div>
  </form>
</div>
{% endblock %}