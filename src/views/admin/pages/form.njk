{% extends 'layouts/admin.njk' %}
{% block content %}
<div class="page-heading"><div><a href="/admin/pages">← All pages</a><p>Edit your content, preview the layout, then save your changes.</p></div>{% if page.id %}<span class="badge {% if page.published %}badge-success{% else %}badge-warning{% endif %}">{% if page.published %}Published{% else %}Draft{% endif %}</span>{% endif %}</div>
<form action="{% if page.id %}/admin/pages/{{ page.id }}/edit{% else %}/admin/pages{% endif %}" method="POST" class="admin-form page-editor" data-page-editor data-unsaved="{% if flash.error %}true{% else %}false{% endif %}" data-page-id="{{ page.id }}" data-validate>
<div class="editor-layout"><section class="admin-card">
<div class="form-group"><label for="title">Page title</label><input id="title" name="title" value="{{ page.title }}" required maxlength="180" placeholder="Give your page a clear title"></div>
<div class="form-group"><label for="slug">Page address</label><input id="slug" name="slug" value="{{ page.slug }}" {% if page.id %}data-manually-edited="true"{% endif %} pattern="[a-z0-9]+(-[a-z0-9]+)*|" aria-describedby="slug-help"><small id="slug-help">{% if page.id and page.slug == '' %}This is your homepage. Leave the address empty to keep it at /.{% else %}Use lowercase words separated by hyphens, such as sword-training.{% endif %}</small></div>
<div class="form-group"><label for="layout">Layout template</label><input id="layout" name="layout" value="{{ page.layout or '' }}" placeholder="pages/reference.njk"><small>Leave empty for default layout.</small></div>
<div class="form-group dropdown-group" data-checkbox-dropdown data-placeholder="Select data sources..." style="position:relative;">
<label id="sources-label">Data sources</label>
<button type="button" class="dropdown-trigger" aria-labelledby="sources-label sources-display" aria-expanded="false" aria-controls="sources-panel">
  <span id="sources-display" class="dropdown-display">Select data sources...</span>
  <span aria-hidden="true">▼</span>
</button>
<div id="sources-panel" class="dropdown-panel">
  {% for source in ['updates','generalUpdates','councilUpdates','newsUpdates'] %}<label class="dropdown-option"><input type="checkbox" name="dataSources" value="{{ source }}" {% if page.dataSources and source in page.dataSources %}checked{% endif %}> {{ source }}</label>{% endfor %}
  <label class="dropdown-option"><input type="checkbox" name="dataSources" value="glossary" {% if page.dataSources and 'glossary' in page.dataSources %}checked{% endif %}> glossary</label>
  <label class="dropdown-option"><input type="checkbox" name="dataSources" value="members" {% if page.dataSources and 'members' in page.dataSources %}checked{% endif %}> members</label>
  <label class="dropdown-option"><input type="checkbox" name="dataSources" value="champions" {% if page.dataSources and 'champions' in page.dataSources %}checked{% endif %}> Champions (member awards)</label>
  <label class="dropdown-option"><input type="checkbox" name="dataSources" value="fallenHeroes" {% if page.dataSources and 'fallenHeroes' in page.dataSources %}checked{% endif %}> Fallen Heroes (members)</label>
  <label class="dropdown-option"><input type="checkbox" name="dataSources" value="councilMembers" {% if page.dataSources and 'councilMembers' in page.dataSources %}checked{% endif %}> Council members (filtered members)</label>
  <label class="dropdown-option"><input type="checkbox" name="dataSources" value="currentCouncilMembers" {% if page.dataSources and 'currentCouncilMembers' in page.dataSources %}checked{% endif %}> Current council members (filtered members)</label>
  <label class="dropdown-option"><input type="checkbox" name="dataSources" value="classes" {% if page.dataSources and 'classes' in page.dataSources %}checked{% endif %}> classes</label>
  <label class="dropdown-option"><input type="checkbox" name="dataSources" value="moves" {% if page.dataSources and 'moves' in page.dataSources %}checked{% endif %}> moves</label>
  <label class="dropdown-option"><input type="checkbox" name="dataSources" value="coreMoves" {% if page.dataSources and 'coreMoves' in page.dataSources %}checked{% endif %}> coreMoves</label>
  <label class="dropdown-option"><input type="checkbox" name="dataSources" value="dalmaterColors" {% if page.dataSources and 'dalmaterColors' in page.dataSources %}checked{% endif %}> Dalmater colors (member profiles)</label>
</div>
</div>


<div class="form-group"><label for="parentSlug">Parent page</label><select id="parentSlug" name="parentSlug"><option value="" {% if not page.parentSlug %}selected{% endif %}>— None (root) —</option>{% for p in pages %}{% if p.id != page.id %}<option value="{{ p.slug }}" {% if page.parentSlug == p.slug %}selected{% endif %}>{{ p.title }} ({{ p.slug }})</option>{% endif %}{% endfor %}</select><small>Leave empty for root pages.</small></div>
<div class="form-group"><label for="styleOverrides">Style overrides</label><textarea id="styleOverrides" name="styleOverrides" rows="3" placeholder="Optional CSS snippet">{{ page.styleOverrides or '' }}</textarea><small>Optional custom CSS for this page.</small></div>
<h2>Page content</h2>
{% if page.slug == "member-profiles" %}<div class="notice">Member names, rankings, and profiles are managed in <a href="/admin/members">Members</a>. Use this editor for the page heading and surrounding content; keep the roster header in place.</div>{% endif %}
<div class="editor-modes" aria-label="Editor mode"><button type="button" class="editor-btn" data-editor-mode="visual" aria-pressed="false">Visual editor</button><button type="button" class="editor-btn" data-editor-mode="source" aria-pressed="true">HTML source</button></div>
<p class="editor-status" role="status" data-editor-status>Content loaded. HTML editing is available even if the visual editor cannot load.</p>
<div data-visual-panel hidden><div class="editor-toolbar" aria-label="Text formatting">{% for command, label in [['bold', 'Bold'], ['italic', 'Italic'], ['h2', 'Heading'], ['p', 'Paragraph'], ['insertUnorderedList', 'Bullet list'], ['createLink', 'Link'], ['undo', 'Undo']] %}<button type="button" class="editor-btn" data-command="{{ command }}">{{ label }}</button>{% endfor %}</div><iframe class="editor-frame" title="Page content visual editor" sandbox="allow-same-origin"></iframe></div>
<label for="content" class="eyebrow" data-source-label>HTML content</label><textarea id="content" name="content" class="source-editor" rows="24" spellcheck="false">{{ page.content }}</textarea>
</section><aside class="admin-card editor-sidebar"><h2>Publishing</h2><p class="text-muted">Save as a draft to keep a page off the public website.</p><label class="check-label"><input type="checkbox" name="published" {% if page and page.published %}checked{% endif %}> Published</label><p class="editor-status" data-save-status role="status">{% if flash.error %}Unsaved changes{% elif page.id %}All changes saved{% else %}New draft{% endif %}</p><button class="btn btn-primary" type="submit">{% if page.id %}Save changes{% else %}Create page{% endif %}</button>{% if page and page.published %}<a class="btn" href="/{{ page.slug }}" target="_blank" rel="noopener">View published page ↗</a>{% endif %}<a class="btn" href="/admin/pages">Back to pages</a><hr><small>Visual mode edits the page body. Use HTML source for layout, images, and embedded content. Changes go live only when you save a published page.</small></aside></div></form>
{% endblock %}
