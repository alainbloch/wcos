{% extends 'layouts/admin.njk' %}
{% block content %}
<div class="page-heading"><div><h2>Your website pages</h2><p>Find a page to update, or create something new. Drafts stay off the public site.</p></div><a href="/admin/pages/new" class="btn btn-primary">+ New page</a></div>
{% if pages.length %}<section data-table-filter><div class="table-tools"><div class="form-group"><label for="page-search">Find a page</label><input type="search" class="form-input" id="page-search" data-search placeholder="Search by title or address…"></div><div class="form-group filter-status"><label for="page-status">Status</label><select id="page-status" data-status><option value="">All pages</option value="published">Published</option><option value="draft">Draft</option></select></div></div>
<div class="admin-table-container"><table class="admin-table"><thead><tr><th scope="col">Page</th><th scope="col">Status</th><th scope="col">Last updated</th><th scope="col">Actions</th></tr></thead><tbody>{% for page in pages %}<tr data-status="{% if page.published %}published{% else %}draft{% endif %}"><td><a href="/admin/pages/{{ page.id }}/edit">{{ page.title }}</a><small>/{{ page.slug }}</small></td><td><span class="badge {% if page.published %}badge-success{% else %}badge-warning{% endif %}">{% if page.published %}Published{% else %}Draft{% endif %}</span></td><td>{{ page.updatedAt | date('MMM d, yyyy') or '—' }}</td><td><div class="actions"><a class="btn btn-sm" href="/admin/pages/{{ page.id }}/edit" aria-label="Edit {{ page.title }}">Edit</a>{% if page.published %}<a class="btn btn-sm" href="/{{ page.slug }}" target="_blank" rel="noopener" aria-label="View {{ page.title }}">View ↗</a>{% endif %}<form action="/admin/pages/{{ page.id }}/delete" method="POST"><button class="btn btn-sm btn-danger" data-confirm-delete="Delete '{{ page.title }}'? This permanently removes the page." aria-label="Delete {{ page.title }}">Delete</button></form></div></td></tr>{% endfor %}</tbody></table></div><p class="result-count" data-result-count role="status"></p><div class="empty-state" data-no-results hidden>No matching pages. Try a different search or status.</div></section>
{% else %}<div class="empty-state"><h2>Your first page starts here</h2><p>Add a title and content, then save it as a draft or publish it.</p><a href="/admin/pages/new" class="btn btn-primary">Create a page</a></div>{% endif %}
{% endblock %}