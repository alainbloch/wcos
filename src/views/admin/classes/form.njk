{% extends 'layouts/admin.njk' %}

{% block content %}
<div class="admin-content">
  <div class="page-heading">

    <a href="/admin/classes" class="btn btn-secondary">← Back to Classes</a>
  </div>

  <form method="POST" action="{% if class.id %}/admin/classes/{{ class.id }}/edit{% else %}/admin/classes{% endif %}" class="admin-form">
    <div class="form-grid">
      <fieldset class="form-section">
        <legend>Class Information</legend>

        <div class="form-field">
          <label for="name">Class Name <span class="required">*</span></label>
          <input type="text" id="name" name="name" value="{{ class.name or '' }}" required placeholder="e.g., Beginner Sword Class, Advanced Steel Training">
        </div>

        <div class="form-group dropdown-group" data-checkbox-dropdown data-placeholder="Select instructors..." style="position:relative;">
          <label id="instructors-label">Instructors</label>
          <button type="button" class="dropdown-trigger" aria-labelledby="instructors-label instructors-display" aria-expanded="false" aria-controls="instructors-panel"><span id="instructors-display" class="dropdown-display">Select instructors...</span><span aria-hidden="true">▼</span></button>
          <div id="instructors-panel" class="dropdown-panel">
            {% for member in instructors %}<label class="dropdown-option"><input type="checkbox" name="instructorIds" value="{{ member.id }}" data-label="{{ member.position }}" {% if class.instructorIds and member.id in class.instructorIds %}checked{% endif %}> {{ member.position }}</label>{% else %}<p>No Kaiden members available.</p>{% endfor %}
          </div>
        </div>
        {% if class.unresolvedInstructors.length %}<p class="notice">Unresolved imported instructors: {{ class.unresolvedInstructors | join(', ') }}. Select the correct members above.</p><label><input type="checkbox" name="clearUnresolved"> Clear these imported names after resolving them</label>{% endif %}

        <div class="form-field">
          <label for="location">Location</label>
          <input type="text" id="location" name="location" value="{{ class.location or '' }}" placeholder="Venue name, address">
        </div>

        <div class="form-field">
          <label for="region">Region</label>
          <input type="text" id="region" name="region" value="{{ class.region or '' }}" placeholder="e.g., Bay Area, Seattle, Portland">
        </div>

        <div class="form-field">
          <label for="schedule">Schedule</label>
          <input type="text" id="schedule" name="schedule" value="{{ class.schedule or '' }}" placeholder="e.g., Tuesdays 7-9pm, Saturdays 10am-12pm">
        </div>

        <div class="form-field form-section-full">
          <label for="description">Description</label>
          <textarea id="description" name="description" rows="4" placeholder="Class description, what to expect, prerequisites...">{{ class.description or '' }}</textarea>
        </div>

        <div class="form-field checkbox-field">
          <input type="checkbox" id="active" name="active" {% if class.active != false %}checked{% endif %}>
          <label for="active">Active Class</label>
        </div>
      </fieldset>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">{% if class.id %}Update Class{% else %}Create Class{% endif %}</button>
      <a href="/admin/classes" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div>
{% endblock %}
