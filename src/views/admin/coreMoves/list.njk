{% extends 'layouts/admin.njk' %}

{% block content %}
<div class="admin-content">
  <div class="flex justify-between items-center mb-6">
    <h2>Core Moves</h2>
    <a href="/admin/core-moves/new" class="btn btn-primary">+ Add Core Move</a>
  </div>

  <div class="notice">Manage core moves for the knowledge base. Organized by category on the public page.</div>
  {% if coreMoves and coreMoves.length > 0 %}
  <div class="admin-table-container">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Category</th>
          <th>Description</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for move in coreMoves %}
        <tr>
          <td><strong>{{ move.name }}</strong></td>
          <td>{{ move.category or '-' }}</td>
          <td>{{ move.description ? move.description.substring(0, 80) + '...' : '-' }}</td>
          <td class="actions-cell">
            <a href="/admin/core-moves/{{ move.id }}/edit" class="btn btn-sm btn-secondary" title="Edit">✏️ Edit</a>
            <form method="POST" action="/admin/core-moves/{{ move.id }}/delete" class="inline-form" onsubmit="return confirm('Delete {{ move.name }}? This cannot be undone.');">
              <button type="submit" class="btn btn-sm btn-danger" title="Delete">🗑️ Delete</button>
            </form>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% else %}
  <div class="text-center py-12">
    <p class="text-muted">No core moves yet.</p>
    <a href="/admin/core-moves/new" class="btn btn-primary mt-4">+ Add First Core Move</a>
  </div>
  {% endif %}
</div>
{% endblock %}