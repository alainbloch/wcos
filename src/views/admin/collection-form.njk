<form class="admin-form" method="POST" action="{{ formAction }}">
<input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="_generated" value="true">
{% for field in definition.fields %}
<div class="form-group"><label for="record-{{ field.name }}">{{ field.label }}</label>
{% if field.type == 'relationship' or field.control == 'reference' %}<select id="record-{{ field.name }}" name="{{ field.name }}" {% if field.cardinality in ['one-to-many','many-to-many'] %}multiple{% endif %}><option value="">Choose…</option>{% for option in choices[field.name] %}<option value="{{ option.id }}" {% if record[field.name] == option.id or (record[field.name] and option.id in record[field.name]) %}selected{% endif %}>{{ option.position or option.name or option.title or option.id }}</option>{% endfor %}</select>
{% elif field.type == 'boolean' %}<input type="checkbox" id="record-{{ field.name }}" name="{{ field.name }}" {% if record[field.name] %}checked{% endif %}>
{% elif field.type == 'enum' %}<select id="record-{{ field.name }}" name="{{ field.name }}"><option value="">Choose…</option>{% for option in field.options %}<option value="{{ option }}" {% if record[field.name] == option %}selected{% endif %}>{{ option }}</option>{% endfor %}</select>
{% elif field.type in ['text','richtext','array','object'] or field.control == 'textarea' %}<textarea id="record-{{ field.name }}" name="{{ field.name }}" rows="5">{{ formValues[field.name] }}</textarea>
{% else %}<input id="record-{{ field.name }}" name="{{ field.name }}" value="{{ formValues[field.name] }}" type="{% if field.type in ['number','date'] %}{{ field.type }}{% else %}text{% endif %}" {% if field.type == 'number' %}step="any"{% endif %}>{% endif %}
{% if field.type == "media" and record[field.name] %}<div class="image-preview"><img src="{{ record[field.name] }}" alt="Current media" style="max-width:200px"></div>{% endif %}
{% if errors[field.name] %}<p role="alert">{{ errors[field.name] }}</p>{% endif %}
</div>{% endfor %}<button type="submit" class="btn btn-primary">Save record</button></form>
